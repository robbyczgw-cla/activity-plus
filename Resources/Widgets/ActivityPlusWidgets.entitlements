<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit only loads sandboxed extensions. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reads the snapshot the app writes. Team-ID prefix: macOS authorizes it from the signature, no profile needed. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>P35939S43T.at.hifiteam.activityplus</string>
	</array>
</dict>
</plist>
