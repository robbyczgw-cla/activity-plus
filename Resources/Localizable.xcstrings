    "Nothing is slowing it down right now. A few things are worth knowing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade bremst ihn nichts. Ein paar Dinge sind trotzdem gut zu wissen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo nada lo ralentiza. Hay algunas cosas que conviene saber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne le ralentit pour l’instant. Quelques points méritent d’être connus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento nulla lo sta rallentando. Ci sono alcune cose da sapere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Macを遅くしているものはありません。知っておくと役立つことがいくつかあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada o está desacelerando agora. Há algumas coisas que vale saber."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有拖慢它的因素。以下几点值得了解。"
          }
        }
      }
    },
