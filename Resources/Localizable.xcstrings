    "System files can be changed by any app with admin rights. Turn it back on from Recovery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemdateien können von jeder App mit Admin-Rechten geändert werden. Schalte den Schutz im Wiederherstellungsmodus wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier app con derechos de administrador puede cambiar los archivos del sistema. Vuelve a activarla desde Recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers système peuvent être modifiés par toute app disposant des droits d’administrateur. Réactivez la protection depuis le mode de récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file di sistema possono essere modificati da qualsiasi app con privilegi di amministratore. Riattivala dalla modalità di ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限のあるAppであれば、システムファイルを変更できます。リカバリからオンに戻してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos do sistema podem ser alterados por qualquer app com direitos de administrador. Reative-a pelo modo de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有管理员权限的App都可以更改系统文件。请在恢复模式中重新开启。"
          }
        }
      }
    },
    "System-wide items need an administrator. Copy the command and run it in Terminal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemweite Objekte brauchen Administratorrechte. Kopiere den Befehl und führe ihn im Terminal aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de todo el sistema necesitan un administrador. Copia el comando y ejecútalo en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments à l’échelle du système nécessitent un administrateur. Copiez la commande et exécutez-la dans Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi a livello di sistema richiedono un amministratore. Copia il comando ed eseguilo nel Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体の項目には管理者権限が必要です。コマンドをコピーして、ターミナルで実行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens de todo o sistema precisam de um administrador. Copie o comando e execute-o no Terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统级项目需要管理员权限。请拷贝该命令并在“终端”中运行。"
          }
        }
      }
    },
