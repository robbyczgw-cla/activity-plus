    " If it is running, it is asked to quit first. You can put it back from the Trash until you empty it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Läuft die App, wird sie zuerst zum Beenden aufgefordert. Du kannst sie aus dem Papierkorb zurücklegen, bis du ihn leerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Si está en ejecución, primero se le pide que salga. Puedes recuperarla desde la Papelera hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " S’il est en cours d’exécution, on lui demande d’abord de quitter. Vous pouvez le remettre depuis la Corbeille tant que vous ne l’avez pas vidée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Se è in esecuzione, le viene chiesto prima di uscire. Puoi recuperarla dal Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 実行中の場合は、先に終了を求めます。ゴミ箱を空にするまでは、ゴミ箱から元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Se estiver em execução, primeiro será pedido que ele seja encerrado. Você pode restaurá-lo da Lixeira até esvaziá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 如果正在运行，会先请求其退出。清倒废纸篓之前，你可以从废纸篓中将其放回。"
          }
        }
      }
    },
