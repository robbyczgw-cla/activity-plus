    " %@ is doing most of it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Den Großteil davon verursacht %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ hace la mayor parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ fait l’essentiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ sta facendo la maggior parte del lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 大部分は%@によるものです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ faz a maior parte disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 其中大部分来自%@。"
          }
        }
      }
    },
    " %@ uses the most GPU time.": {
