            "value": "%@ in den Papierkorb gelegt. Den Platz bekommst du erst zurück, wenn du den Papierkorb leerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha movido %@ a la Papelera. Vacía la Papelera para liberar el espacio de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ déplacé dans la Corbeille. Videz la Corbeille pour libérer réellement l’espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato nel Cestino: %@. Svuota il Cestino per liberare davvero lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をゴミ箱に入れました。ゴミ箱を空にすると実際に容量が空きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ movido para a Lixeira. Esvazie a Lixeira para liberar o espaço de fato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将%@移到废纸篓。清倒废纸篓后才会真正释放空间。"
          }
        }
      }
    },
