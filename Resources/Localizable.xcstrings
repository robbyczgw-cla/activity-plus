        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をゴミ箱に入れます。ゴミ箱を空にするまでは、すべてゴミ箱から元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
