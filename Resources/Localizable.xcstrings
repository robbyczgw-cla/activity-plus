    "Measuring walks a few folders and takes a few seconds, longer if Xcode simulators or big caches are present.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Messen durchsucht einige Ordner und dauert ein paar Sekunden, länger bei Xcode-Simulatoren oder großen Caches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medir recorre algunas carpetas y tarda unos segundos; más si hay simuladores de Xcode o cachés grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure parcourt quelques dossiers et prend quelques secondes, davantage si des simulateurs Xcode ou de gros caches sont présents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La misurazione esamina alcune cartelle e richiede pochi secondi, di più se sono presenti simulatori Xcode o cache grandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計測では数個のフォルダを調べるため、数秒かかります。Xcodeのシミュレータや大きなキャッシュがある場合は、さらに時間がかかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A medição percorre algumas pastas e leva alguns segundos; leva mais tempo se houver simuladores do Xcode ou caches grandes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量会遍历若干文件夹，需要几秒钟；如果存在Xcode模拟器或大型缓存，则时间更长。"
          }
        }
      }
    },
    "Measuring with every window visible": {
      "localizations": {
