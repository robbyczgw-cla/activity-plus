    "Per-app writes are counted from version 0.3 on. The list fills up while Activity+ runs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibzugriffe pro App werden ab Version 0.3 gezählt. Die Liste füllt sich, während Activity+ läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las escrituras por app se cuentan desde la versión 0.3. La lista se llena mientras Activity+ está en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écritures par app sont comptées à partir de la version 0.3. La liste se remplit pendant l’exécution d’Activity+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scritture per app vengono conteggiate dalla versione 0.3. L’elenco si riempie mentre Activity+ è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの書き込み量は、バージョン0.3以降で記録されます。リストはActivity+の実行中に蓄積されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações por app são contadas a partir da versão 0.3. A lista é preenchida enquanto o Activity+ roda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各App的写入量自0.3版起开始统计。Activity+运行期间，列表会逐渐丰富。"
          }
        }
      }
    },
