    "Rules": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas"
          }
        },
        "fr": {
