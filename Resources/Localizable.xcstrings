    "The %lld W adapter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das %lld-W-Netzteil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador de %lld W"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptateur de %lld W"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alimentatore da %lld W"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Wの電源アダプタ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O adaptador de %lld W"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld W适配器"
          }
        }
      }
    },
    "The CPU averaged %@ over the last minutes. Everything else has to wait for it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CPU lag in den letzten Minuten im Schnitt bei %@. Alles andere muss auf sie warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU promedió %@ en los últimos minutos. Todo lo demás tiene que esperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le CPU a tourné en moyenne à %@ ces dernières minutes. Tout le reste doit attendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU ha avuto una media di %@ negli ultimi minuti. Tutto il resto deve attenderla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUの使用率はここ数分間で平均%@でした。ほかの処理はすべてその完了を待つことになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A CPU teve média de %@ nos últimos minutos. Todo o resto precisa esperar por ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近几分钟CPU平均占用%@。其他一切都要等它。"
          }
        }
      }
    },
    "The Mac needs more than the adapter delivers, so the battery makes up the rest. A stronger adapter or fewer heavy apps help.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac braucht mehr, als das Netzteil liefert; die Batterie gleicht den Rest aus. Ein stärkeres Netzteil oder weniger Apps mit hoher Last helfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac necesita más de lo que entrega el adaptador, así que la batería aporta el resto. Ayuda un adaptador más potente o tener menos apps pesadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac demande plus que ce que fournit l’adaptateur : la batterie compense le reste. Un adaptateur plus puissant ou moins d’apps gourmandes aident."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac richiede più di quanto eroga l’alimentatore, quindi la batteria copre la differenza. Aiutano un alimentatore più potente o meno app pesanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが必要とする電力が電源アダプタの供給量を上回っているため、不足分をバッテリーで補っています。出力の大きい電源アダプタを使うか、負荷の高いアプリを減らすと改善します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac precisa de mais do que o adaptador fornece, então a bateria complementa o restante. Um adaptador mais potente ou menos apps pesados ajudam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac所需功率超过适配器的输出，不足的部分由电池补充。使用功率更大的适配器或减少高负载App会有帮助。"
          }
        }
      }
    },
    "The Mac was plugged in the whole time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac war die ganze Zeit am Netzteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac ha estado conectado a la corriente todo el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac est resté branché pendant toute la période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac è stato sempre collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macはずっと電源に接続されていました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac esteve conectado o tempo todo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac全程接着电源。"
          }
        }
      }
    },
    "The Mac woke for a scheduled timer or maintenance task.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac ist für einen geplanten Timer oder eine Wartungsaufgabe aufgewacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac despertó por un temporizador programado o una tarea de mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac s’est réveillé pour une minuterie programmée ou une tâche de maintenance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac si è risvegliato per un timer pianificato o un’attività di manutenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されたタイマーまたはメンテナンス作業のために、Macがスリープ解除されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac acordou por um temporizador agendado ou uma tarefa de manutenção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac因定时器或维护任务而唤醒。"
          }
        }
      }
    },
    "The adapter or cable limits the charging speed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzteil oder Kabel begrenzen die Ladegeschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador o el cable limitan la velocidad de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptateur ou le câble limite la vitesse de charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alimentatore o il cavo limitano la velocità di ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アダプタまたはケーブルが、充電速度を制限しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O adaptador ou o cabo limita a velocidade de carregamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适配器或线缆限制了充电速度。"
          }
        }
      }
    },
    "The app stopped responding": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat nicht mehr reagiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app dejó de responder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app a cessé de répondre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ha smesso di rispondere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appが応答しなくなりました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
