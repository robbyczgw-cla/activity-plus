    "Any app can open without being checked first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App kann sich öffnen, ohne vorher geprüft zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier app puede abrirse sin comprobación previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute app peut s’ouvrir sans avoir été vérifiée au préalable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi app può essere aperta senza essere controllata prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのAppが、事前の確認なしで開けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer app pode ser aberto sem verificação prévia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何App都可以直接打开，无需先检查。"
          }
        }
      }
    },
    "Anyone holding this Mac can read the disk. Turn it on in System Settings, Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer diesen Mac in der Hand hat, kann die Festplatte lesen. Schalte es in den Systemeinstellungen unter Datenschutz & Sicherheit ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que tenga este Mac puede leer el disco. Actívalo en Ajustes del Sistema › Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque a ce Mac entre les mains peut lire le disque. Activez-le dans Réglages Système, Confidentialité et sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia in mano questo Mac può leggere il disco. Attivalo in Impostazioni di Sistema, Privacy e sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacを手にした人は誰でもディスクを読み取れます。「システム設定」の「プライバシーとセキュリティ」でオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem tiver este Mac em mãos pode ler o disco. Ative-o em Ajustes do Sistema, Privacidade e Segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拿到这台Mac的人都能读取磁盘。请在“系统设置”>“隐私与安全性”中开启。"
          }
        }
      }
    },
