    "You get a notification when an app hogs the CPU, keeps growing in memory, or hammers the disk or network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst eine Mitteilung, wenn eine App die CPU belegt, immer mehr Speicher braucht oder Festplatte oder Netzwerk stark belastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás una notificación cuando una app acapare la CPU, siga creciendo en memoria o sature el disco o la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevez une notification lorsqu’une app monopolise le CPU, continue de grossir en mémoire, ou sollicite fortement le disque ou le réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando un’app monopolizza la CPU, continua a crescere in memoria o sollecita il disco o la rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがCPUを占有したり、メモリ使用量が増え続けたり、ディスクやネットワークに大きな負荷をかけたりすると、通知が届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você recebe uma notificação quando um app monopoliza a CPU, continua crescendo em memória ou sobrecarrega o disco ou a rede."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当App占用大量CPU、内存持续增长，或频繁读写磁盘或网络时，你会收到通知。"
          }
        }
      }
    },
    "You set a charge limit of %lld %% in Battery settings. Staying below full slows battery ageing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in den Batterieeinstellungen ein Ladelimit von %lld %% festgelegt. Wenn die Batterie nicht ganz voll wird, altert sie langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has establecido un límite de carga del %lld %% en los ajustes de batería. Mantenerla por debajo de llena ralentiza el envejecimiento de la batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez défini une limite de charge de %lld %% dans les réglages de la batterie. Rester en dessous de la pleine charge ralentit le vieillissement de la batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai impostato un limite di carica del %lld %% nelle impostazioni della batteria. Restare sotto la carica piena rallenta l’invecchiamento della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー設定で充電上限を%lld%%に設定しています。満充電を避けると、バッテリーの劣化が遅くなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você definiu um limite de carga de %lld %% nos Ajustes da bateria. Manter a carga abaixo do máximo reduz o envelhecimento da bateria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在“电池”设置中设定了%lld%%的充电上限。不充满电可减缓电池老化。"
          }
        }
      }
    },
