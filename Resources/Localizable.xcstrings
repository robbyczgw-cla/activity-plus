    "No Dock icon. Open the window from any menu bar item (right-click → Open Activity+).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Dock-Symbol. Öffne das Fenster über ein beliebiges Objekt in der Menüleiste (Rechtsklick → Activity+ öffnen)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin icono en el Dock. Abre la ventana desde cualquier elemento de la barra de menús (clic secundario → Abrir Activity+)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune icône dans le Dock. Ouvrez la fenêtre depuis n’importe quel élément de la barre des menus (clic droit → Ouvrir Activity+)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
