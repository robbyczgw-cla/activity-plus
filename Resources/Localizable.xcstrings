          "stringUnit": {
            "state": "translated",
            "value": "Animationen und Videos können ruckeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las animaciones y el vídeo pueden ir a tirones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les animations et les vidéos peuvent saccader."
          }
        },
        "it": {
