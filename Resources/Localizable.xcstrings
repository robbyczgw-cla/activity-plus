    "Click a folder to look inside. Colors show the kind of files that take most of each folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Ordner, um hineinzusehen. Die Farben zeigen, welche Dateitypen in jedem Ordner am meisten Platz belegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una carpeta para ver su contenido. Los colores indican el tipo de archivo que más espacio ocupa en cada carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un dossier pour voir ce qu’il contient. Les couleurs indiquent le type de fichiers qui occupe le plus de place dans chaque dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su una cartella per guardarne il contenuto. I colori mostrano il tipo di file che occupa più spazio in ciascuna cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダをクリックすると中身を表示します。色は、各フォルダで最も容量を使っているファイルの種類を示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma pasta para ver o conteúdo. As cores mostram o tipo de arquivo que ocupa mais espaço em cada pasta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按文件夹可查看其中内容。颜色表示占用每个文件夹最多空间的文件种类。"
          }
        }
      }
    },
    "Click a menu bar item for the panel, or use the Dock icon for the window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Objekt in der Menüleiste für das Panel oder nutze das Dock-Symbol für das Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un elemento de la barra de menús para ver el panel, o usa el icono del Dock para la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un élément de la barre des menus pour afficher le panneau, ou sur l’icône du Dock pour la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un elemento della barra dei menu per il pannello, oppure usa l’icona del Dock per la finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの項目をクリックするとパネルが、Dockのアイコンをクリックするとウインドウが開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um item da barra de menus para abrir o painel, ou use o ícone no Dock para abrir a janela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏项目可打开面板，点按Dock图标可打开窗口。"
          }
        }
      }
    },
    "Click a session to see it; tick a second one to compare.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf eine Aufnahme, um sie anzusehen; hake eine zweite an, um zu vergleichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una sesión para verla; marca una segunda para compararlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une session pour la voir ; cochez-en une seconde pour les comparer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su una sessione per vederla; selezionane una seconda per confrontarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションをクリックして表示します。2つ目にチェックを入れると比較できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma sessão para vê-la; marque uma segunda para comparar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一个录制项可查看；勾选另一个可进行对比。"
          }
        }
      }
    },
