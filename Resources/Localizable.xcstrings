    "Rules that act for you. Each rule either asks first with a notification button, or — only if you switch it to automatic — acts on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln, die für dich handeln. Jede Regel fragt zuerst über einen Knopf in der Mitteilung oder handelt selbst, aber nur, wenn du sie auf automatisch stellst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas que actúan por ti. Cada regla pregunta primero con un botón de notificación o, solo si la cambias a automática, actúa por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des règles qui agissent pour vous. Chaque règle demande d’abord confirmation par un bouton de notification ou, uniquement si vous la passez en automatique, agit seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regole che agiscono per te. Ogni regola chiede prima con un pulsante di notifica oppure — solo se la imposti come automatica — agisce da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザに代わって動作するルールです。各ルールは、通知のボタンで先に確認するか、自動に切り替えた場合に限り、自動的に実行されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras que agem por você. Cada regra pergunta antes com um botão de notificação ou, somente se você a mudar para automática, age por conta própria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代你执行操作的规则。每条规则要么先通过通知按钮询问你，要么（仅当你将其切换为自动时）自行执行。"
          }
        }
      }
    },
