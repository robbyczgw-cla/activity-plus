    "Heat, memory pressure and Wi-Fi signal are kept from version 0.3 on. Come back in a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitze, Speicherdruck und WLAN-Signal werden ab Version 0.3 aufgezeichnet. Schau in ein paar Minuten wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calor, la presión de memoria y la señal Wi-Fi se guardan desde la versión 0.3. Vuelve dentro de unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chaleur, la pression mémoire et le signal Wi-Fi sont conservés à partir de la version 0.3. Revenez dans quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calore, pressione della memoria e segnale Wi-Fi vengono salvati dalla versione 0.3. Torna tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱、メモリプレッシャー、Wi-Fiの信号は、バージョン0.3以降で記録されます。数分後にもう一度ご確認ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calor, pressão de memória e sinal do Wi-Fi são guardados a partir da versão 0.3. Volte em alguns minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发热、内存压力和无线局域网信号自0.3版起开始记录。请过几分钟再来查看。"
          }
        }
      }
    },
