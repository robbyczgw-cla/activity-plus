    "Automations that found something to do and wait for you to allow it, for example quitting an idle dev server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automationen, die etwas zu tun gefunden haben und auf deine Erlaubnis warten, zum Beispiel einen inaktiven Dev-Server zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatizaciones que han encontrado algo que hacer y esperan tu permiso, por ejemplo cerrar un servidor de desarrollo inactivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisations qui ont trouvé quelque chose à faire et attendent votre accord, par exemple l’arrêt d’un serveur de développement inactif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automazioni che hanno trovato qualcosa da fare e attendono la tua approvazione, per esempio chiudere un server di sviluppo inattivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行すべきことを見つけ、許可を待っている自動処理です。たとえば、アイドル状態の開発サーバを終了する処理などです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
