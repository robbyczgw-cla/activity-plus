    "%@ moves to the Trash. Quit the apps first so they do not recreate their caches right away. Empty the Trash to actually free the space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird in den Papierkorb gelegt. Beende die Apps vorher, damit sie ihre Caches nicht sofort neu anlegen. Den Platz bekommst du erst zurück, wenn du den Papierkorb leerst."
          }
        }
      }
    },
    "%@ moves to the Trash. You can put everything back from the Trash until you empty it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird in den Papierkorb gelegt. Bis du ihn leerst, kannst du alles wieder zurücklegen."
          }
        }
      }
    },
