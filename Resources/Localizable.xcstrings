    "Menu bar, panel, alert rules, automations and performance switches in one file, for another Mac or a fresh start. History stays on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste, Panel, Warnregeln, Automationen und Leistungsschalter in einer Datei, für einen anderen Mac oder einen Neuanfang. Der Verlauf bleibt auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra de menús, panel, reglas de alerta, automatizaciones y opciones de rendimiento en un solo archivo, para otro Mac o para empezar de cero. El historial se queda en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre des menus, panneau, règles d’alerte, automatisations et interrupteurs de performance dans un seul fichier, pour un autre Mac ou une nouvelle installation. L’historique reste sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra dei menu, pannello, regole di avviso, automazioni e interruttori delle prestazioni in un unico file, per un altro Mac o per ripartire da zero. La cronologia resta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー、パネル、アラートルール、オートメーション、パフォーマンス切り替えを1つのファイルにまとめます。別のMacへの移行や、最初からやり直す場合に使えます。履歴はこのMacに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra de menus, painel, regras de alerta, automações e chaves de desempenho em um único arquivo, para outro Mac ou um começo do zero. O histórico permanece neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏、面板、提醒规则、自动化和性能开关，合并在一个文件中，可用于另一台Mac或重新开始。历史记录保留在这台Mac上。"
          }
        }
      }
    },
