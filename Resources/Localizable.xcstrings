    "Leave the Mac alone meanwhile, or the measurement gets noisy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Mac währenddessen in Ruhe, sonst wird die Messung ungenau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el Mac tranquilo mientras tanto, o la medición se llenará de ruido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez le Mac tranquille pendant ce temps, sinon la mesure sera bruitée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo lascia in pace il Mac, altrimenti la misura si disturba."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定中はMacを操作しないでください。測定値にばらつきが出ます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o Mac em paz enquanto isso, ou a medição fica imprecisa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量期间请不要操作Mac，否则结果会受到干扰。"
          }
        }
      }
    },
