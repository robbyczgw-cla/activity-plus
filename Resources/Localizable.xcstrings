    "%@ in %lld items move to the Trash. The space is only freed when you empty the Trash. Items of apps that are open are left alone.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ in %lld Objekt wird in den Papierkorb gelegt. Der Platz wird erst frei, wenn du den Papierkorb leerst. Objekte geöffneter Apps bleiben unberührt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ in %lld Objekten werden in den Papierkorb gelegt. Der Platz wird erst frei, wenn du den Papierkorb leerst. Objekte geöffneter Apps bleiben unberührt."
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$lld items move to the Trash. The space is only freed when you empty the Trash. Items of apps that are open are left alone."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ en %lld elemento se mueve a la Papelera. El espacio solo se libera al vaciar la Papelera. Los elementos de las apps abiertas no se tocan."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ en %lld elementos se mueven a la Papelera. El espacio solo se libera al vaciar la Papelera. Los elementos de las apps abiertas no se tocan."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ dans %lld élément sera déplacé dans la Corbeille. L’espace n’est libéré qu’une fois la Corbeille vidée. Les éléments des apps ouvertes sont laissés de côté."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ dans %lld éléments seront déplacés dans la Corbeille. L’espace n’est libéré qu’une fois la Corbeille vidée. Les éléments des apps ouvertes sont laissés de côté."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ in %lld elemento viene spostato nel Cestino. Lo spazio viene liberato solo quando svuoti il Cestino. Gli elementi delle app aperte vengono lasciati intatti."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ in %lld elementi vengono spostati nel Cestino. Lo spazio viene liberato solo quando svuoti il Cestino. Gli elementi delle app aperte vengono lasciati intatti."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@分の%2$lld個の項目をゴミ箱に入れます。ゴミ箱を空にするまで容量は空きません。開いているアプリの項目はそのままにします。"
          }
