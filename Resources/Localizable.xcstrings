        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déplacé dans la Corbeille. Vous pouvez tout restaurer depuis la Corbeille tant que vous ne l’avez pas vidée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene spostato nel Cestino. Puoi ripristinare tutto dal Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をゴミ箱に入れます。ゴミ箱を空にするまでは、すべてゴミ箱から元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será movido para a Lixeira. Você pode restaurar tudo da Lixeira até esvaziá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
