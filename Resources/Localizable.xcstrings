          }
        }
      }
    },
    "macOS lowers the processor speed to cool down. Give the vents room, remove it from soft surfaces, and quit heavy apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS senkt die Prozessorgeschwindigkeit, um abzukühlen. Gib den Lüftungsschlitzen Platz, nimm den Mac von weichen Unterlagen und beende Apps mit viel Last."
          }
        }
      }
    },
