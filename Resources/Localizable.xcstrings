    "Speeds up launching simulators; Xcode rebuilds it, and the next launch is slower.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschleunigt den Start von Simulatoren; Xcode baut ihn neu auf, der nächste Start ist langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelera el inicio de los simuladores; Xcode lo regenera, y el siguiente inicio será más lento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accélère le lancement des simulateurs ; Xcode le recrée, et le prochain lancement sera plus lent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accelera l’avvio dei simulatori; Xcode lo ricrea e il prossimo avvio sarà più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータの起動を速くします。Xcodeが再構築しますが、次回の起動は遅くなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelera a abertura de simuladores; o Xcode o recria, e a próxima abertura fica mais lenta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加快模拟器的启动；Xcode会重新生成它，下次启动会较慢。"
          }
        }
      }
    },
