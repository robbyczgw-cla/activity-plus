    "Apps using the most energy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps mit dem höchsten Energieverbrauch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que más energía consumen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
