    "Left by macOS updates so the system can be restored. macOS removes them on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von macOS-Updates hinterlassen, damit sich das System wiederherstellen lässt. macOS entfernt sie von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejadas por las actualizaciones de macOS para poder restaurar el sistema. macOS las elimina por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissés par les mises à jour de macOS afin de pouvoir restaurer le système. macOS les supprime automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciati dagli aggiornamenti di macOS per poter ripristinare il sistema. macOS li rimuove da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムを復元できるよう、macOSのアップデートによって残されたものです。macOSが自動的に削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixados por atualizações do macOS para que o sistema possa ser restaurado. O macOS os remove sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由macOS更新留下，以便恢复系统。macOS会自行移除。"
          }
        }
      }
    },
    "Left with the measured apps hidden": {
      "extractionState": "manual",
