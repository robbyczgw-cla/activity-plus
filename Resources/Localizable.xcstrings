    "Python packages pip downloaded earlier; it downloads them again when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Python-Pakete, die pip früher geladen hat; pip lädt sie bei Bedarf erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de Python que pip descargó antes; los vuelve a descargar cuando hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets Python téléchargés plus tôt par pip ; il les télécharge de nouveau au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti Python scaricati in precedenza da pip; vengono scaricati di nuovo quando servono."
          }
