    " %lld more things need attention.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld weitere Dinge brauchen Aufmerksamkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld cosas más necesitan atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld éléments supplémentaires demandent votre attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " altre %lld cose richiedono attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 他に%lld件の確認事項があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " mais %lld coisas precisam de atenção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 另有%lld项需要注意。"
          }
        }
      }
    },
