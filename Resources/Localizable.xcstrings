    "Temporary files %@ keeps to start and load faster; it rebuilds them as it needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien, die %@ aufbewahrt, um schneller zu starten und zu laden; die App legt sie bei Bedarf neu an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales que %@ guarda para arrancar y cargar más rápido; los regenera cuando los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires que %@ conserve pour démarrer et charger plus vite ; il les recrée au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File temporanei che %@ conserva per avviarsi e caricarsi più in fretta; vengono ricreati quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が起動や読み込みを速くするために保持している一時ファイルです。必要に応じて再構築されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários que %@ mantém para iniciar e carregar mais rápido; ele os recria conforme necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@为加快启动和载入而保留的临时文件；需要时会重新生成。"
          }
        }
      }
    },
    "Temporary files kept by an app or tool to run faster; it rebuilds them as it needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien, die eine App oder ein Werkzeug aufbewahrt, um schneller zu laufen; sie werden bei Bedarf neu angelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales que guarda una app o herramienta para funcionar más rápido; los regenera cuando los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires conservés par une app ou un outil pour fonctionner plus vite ; il les recrée au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File temporanei conservati da un’app o da uno strumento per funzionare più velocemente; vengono ricreati quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appやツールが動作を速くするために保持している一時ファイルです。必要に応じて再構築されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários mantidos por um app ou ferramenta para rodar mais rápido; eles são recriados conforme necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App或工具为加快运行而保留的临时文件；需要时会重新生成。"
          }
        }
      }
    },
