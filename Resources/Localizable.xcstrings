    "Xcode rebuilds this the next time you build; the first build is slower.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode baut das beim nächsten Build neu auf; der erste Build ist langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode lo regenera en la próxima compilación; la primera será más lenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode le recrée à la prochaine compilation ; la première sera plus lente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode lo ricrea alla prossima compilazione; la prima sarà più lenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のビルド時にXcodeが再構築します。最初のビルドは遅くなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Xcode recria isso na próxima vez que você compilar; o primeiro build fica mais lento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode会在下次构建时重新生成；首次构建会较慢。"
          }
        }
      }
    },
