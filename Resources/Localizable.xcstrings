    "Images the Android emulator boots from; Android Studio downloads them again when an emulator needs one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbilder, von denen der Android-Emulator startet; Android Studio lädt sie erneut, wenn ein Emulator eines braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes desde las que arranca el emulador de Android; Android Studio las vuelve a descargar cuando un emulador las necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images à partir desquelles démarre l’émulateur Android ; Android Studio les télécharge de nouveau quand un émulateur en a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini da cui si avvia l’emulatore Android; Android Studio le scarica di nuovo quando un emulatore ne ha bisogno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidエミュレータの起動に使うイメージです。エミュレータが必要とするとき、Android Studioが再度ダウンロードします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens que o emulador Android usa para iniciar; o Android Studio as baixa novamente quando um emulador precisa delas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android模拟器启动所用的映像；模拟器需要时，Android Studio会重新下载。"
