    "%@ can do USB 3 but is connected at USB 2 speed, up to ten times slower. Usually the cable is a USB 2 or charging cable, or a hub or port in between only does USB 2. Try another cable or plug it straight into the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann USB 3, ist aber nur mit USB-2-Tempo verbunden, bis zu zehnmal langsamer. Meist ist das Kabel ein USB-2- oder Ladekabel, oder ein Hub oder Anschluss dazwischen kann nur USB 2. Probiere ein anderes Kabel oder stecke das Laufwerk direkt am Mac an."
          }
        }
      }
    },
    "%@ cannot keep up: %@. Use a stronger adapter or close heavy apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommt nicht mit: %@. Nimm ein stärkeres Netzteil oder beende Apps mit viel Last."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ cannot keep up: %2$@. Use a stronger adapter or close heavy apps."
          }
        }
      }
    },
