    "Keeping your Mac awake right now": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deinen Mac gerade wach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteniendo el Mac despierto ahora mismo"
          }
        },
        "fr": {
