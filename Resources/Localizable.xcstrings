    "Xcode archive of an old build; you only need it to submit that build again or to read its crash reports.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode-Archiv eines alten Builds; du brauchst es nur, um diesen Build erneut einzureichen oder seine Absturzberichte zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de Xcode de una compilación antigua; solo lo necesitas para volver a enviar esa compilación o leer sus informes de fallos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive Xcode d’une ancienne compilation ; vous n’en avez besoin que pour soumettre de nouveau cette compilation ou lire ses rapports de plantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio Xcode di una build vecchia; ti serve solo per inviare di nuovo quella build o per leggere i suoi report di crash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いビルドのXcodeアーカイブです。そのビルドを再度提出するときや、クラッシュレポートを読むときにのみ必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo do Xcode de um build antigo; você só precisa dele para enviar esse build de novo ou para ler os relatórios de falhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本的Xcode归档；只有重新提交该版本或读取其崩溃报告时才需要它。"
          }
        }
      }
    },
