    "kernel_task uses CPU time on purpose to keep the processor cool, which usually means the Mac is hot or charging with a weak adapter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_task belegt absichtlich CPU-Zeit, um den Prozessor kühl zu halten. Meist ist der Mac dann heiß oder lädt mit einem schwachen Netzteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_task usa tiempo de CPU a propósito para mantener frío el procesador, lo que normalmente significa que el Mac está caliente o se carga con un adaptador débil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_task utilise du temps CPU volontairement pour garder le processeur au frais, ce qui signifie généralement que le Mac est chaud ou en charge avec un adaptateur faible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_task usa tempo di CPU di proposito per tenere fresco il processore, il che di solito significa che il Mac è caldo o in carica con un alimentatore debole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_taskは、プロセッサを冷却するために意図的にCPU時間を使用します。通常は、Macが高温になっているか、出力の小さい電源アダプタで充電していることを意味します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kernel_task usa tempo de CPU de propósito para manter o processador frio, o que normalmente significa que o Mac está quente ou carregando com um adaptador fraco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_task会有意占用CPU时间来给处理器降温，这通常意味着Mac过热，或正在使用功率较低的适配器充电。"
          }
        }
      }
    },
