    "This Mac has no fans, or does not report them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat keine Lüfter oder meldet sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene ventiladores, o no los informa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas de ventilateur, ou ne les signale pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non ha ventole o non le segnala."
          }
        },
        "ja": {
