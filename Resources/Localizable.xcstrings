    "Installers Homebrew downloaded earlier; `brew cleanup` removes the same files, and Homebrew downloads again what it needs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer, die Homebrew früher geladen hat; `brew cleanup` entfernt dieselben Dateien, und Homebrew lädt bei Bedarf neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que Homebrew descargó antes; `brew cleanup` elimina los mismos archivos, y Homebrew vuelve a descargar lo que necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmes d’installation téléchargés plus tôt par Homebrew ; `brew cleanup` supprime les mêmes fichiers, et Homebrew télécharge de nouveau ce dont il a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer scaricati in precedenza da Homebrew; `brew cleanup` rimuove gli stessi file e Homebrew scarica di nuovo ciò che serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前にHomebrewがダウンロードしたインストーラです。`brew cleanup`でも同じファイルが削除され、必要なものはHomebrewが再度ダウンロードします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que o Homebrew baixou antes; `brew cleanup` remove os mesmos arquivos, e o Homebrew baixa novamente o que precisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew之前下载的安装器；“brew cleanup”会移除相同的文件，Homebrew会重新下载所需内容。"
          }
        }
      }
    },
    "Instructions per cycle": {
