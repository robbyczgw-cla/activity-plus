      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht Downloads, Schreibtisch, Dokumente und Filme nach Installationsprogrammen, die du schon benutzt hast, Downloads, die du nie wieder geöffnet hast, und sehr großen Dateien. Ausgewählt oder entfernt wird nur, was du selbst wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en Descargas, Escritorio, Documentos y Películas instaladores que ya hayas usado, descargas que no volviste a abrir y archivos muy grandes. No se selecciona ni elimina nada a menos que lo elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourt les dossiers Téléchargements, Bureau, Documents et Films à la recherche de programmes d’installation déjà utilisés, de téléchargements jamais rouverts et de très gros fichiers. Rien n’est sélectionné ni supprimé sans votre choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca in Download, Scrivania, Documenti e Film installer già usati, download che non hai più aperto e file molto grandi. Non viene selezionato né rimosso nulla finché non scegli tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」「デスクトップ」「書類」「ムービー」フォルダ内から、使用済みのインストーラ、一度も開いていないダウンロード項目、非常に大きなファイルを探します。ご自身で選択しない限り、選択や削除は行われません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura em Downloads, Mesa, Documentos e Filmes por instaladores já usados, downloads que você nunca mais abriu e arquivos muito grandes. Nada é selecionado nem removido, a menos que você escolha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“下载”“桌面”“文稿”和“影片”文件夹中查找已使用过的安装程序、从未再次打开的下载内容和超大文件。除非你选择，否则不会选中或移除任何内容。"
          }
        }
      }
    },
    "Looks up names for the addresses (sends DNS queries). Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt Namen für die Adressen ab (sendet DNS-Anfragen). Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
