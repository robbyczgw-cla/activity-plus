    "This is what slows your Mac down the most right now; details and a fix are below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bremst deinen Mac gerade am meisten; Details und eine Lösung findest du unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es lo que más ralentiza tu Mac ahora mismo; abajo tienes los detalles y una solución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ce qui ralentit le plus votre Mac en ce moment ; les détails et une solution sont ci-dessous."
          }
        },
        "it": {
