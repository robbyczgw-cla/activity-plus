    "Temporary files %@ keeps to start and load faster; it rebuilds them as it needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien, die %@ aufbewahrt, um schneller zu starten und zu laden; die App legt sie bei Bedarf neu an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales que %@ guarda para arrancar y cargar más rápido; los regenera cuando los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires que %@ conserve pour démarrer et charger plus vite ; il les recrée au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File temporanei che %@ conserva per avviarsi e caricarsi più in fretta; vengono ricreati quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が起動や読み込みを速くするために保持している一時ファイルです。必要に応じて再構築されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários que %@ mantém para iniciar e carregar mais rápido; ele os recria conforme necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@为加快启动和载入而保留的临时文件；需要时会重新生成。"
          }
        }
      }
    },
    "Temporary files kept by an app or tool to run faster; it rebuilds them as it needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien, die eine App oder ein Werkzeug aufbewahrt, um schneller zu laufen; sie werden bei Bedarf neu angelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales que guarda una app o herramienta para funcionar más rápido; los regenera cuando los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires conservés par une app ou un outil pour fonctionner plus vite ; il les recrée au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File temporanei conservati da un’app o da uno strumento per funzionare più velocemente; vengono ricreati quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appやツールが動作を速くするために保持している一時ファイルです。必要に応じて再構築されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários mantidos por um app ou ferramenta para rodar mais rápido; eles são recriados conforme necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App或工具为加快运行而保留的临时文件；需要时会重新生成。"
          }
        }
      }
    },
    "Text logs apps write while they run; new ones are created when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textprotokolle, die Apps während des Betriebs schreiben; neue entstehen bei Bedarf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de texto que las apps escriben mientras se ejecutan; se crean otros nuevos cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux texte écrits par les apps pendant leur exécution ; de nouveaux sont créés au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Log di testo che le app scrivono durante l’esecuzione; quelli nuovi vengono creati quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appが実行中に書き込むテキストのログです。必要に応じて新しく作成されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de texto que os apps gravam durante a execução; novos são criados quando necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App在运行时写入的文本日志；需要时会创建新的日志。"
          }
        }
      }
    },
    "The %lld W adapter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das %lld-W-Netzteil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador de %lld W"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptateur de %lld W"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alimentatore da %lld W"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Wの電源アダプタ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O adaptador de %lld W"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld W适配器"
          }
        }
      }
    },
    "The CPU averaged %@ over the last minutes. Everything else has to wait for it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CPU lag in den letzten Minuten im Schnitt bei %@. Alles andere muss auf sie warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU promedió %@ en los últimos minutos. Todo lo demás tiene que esperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le CPU a tourné en moyenne à %@ ces dernières minutes. Tout le reste doit attendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU ha avuto una media di %@ negli ultimi minuti. Tutto il resto deve attenderla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUの使用率はここ数分間で平均%@でした。ほかの処理はすべてその完了を待つことになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A CPU teve média de %@ nos últimos minutos. Todo o resto precisa esperar por ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近几分钟CPU平均占用%@。其他一切都要等它。"
          }
        }
      }
    },
    "The Mac needs more than the adapter delivers, so the battery makes up the rest. A stronger adapter or fewer heavy apps help.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac braucht mehr, als das Netzteil liefert; die Batterie gleicht den Rest aus. Ein stärkeres Netzteil oder weniger Apps mit hoher Last helfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac necesita más de lo que entrega el adaptador, así que la batería aporta el resto. Ayuda un adaptador más potente o tener menos apps pesadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac demande plus que ce que fournit l’adaptateur : la batterie compense le reste. Un adaptateur plus puissant ou moins d’apps gourmandes aident."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac richiede più di quanto eroga l’alimentatore, quindi la batteria copre la differenza. Aiutano un alimentatore più potente o meno app pesanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが必要とする電力が電源アダプタの供給量を上回っているため、不足分をバッテリーで補っています。出力の大きい電源アダプタを使うか、負荷の高いアプリを減らすと改善します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac precisa de mais do que o adaptador fornece, então a bateria complementa o restante. Um adaptador mais potente ou menos apps pesados ajudam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac所需功率超过适配器的输出，不足的部分由电池补充。使用功率更大的适配器或减少高负载App会有帮助。"
          }
        }
      }
    },
    "The Mac was plugged in the whole time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac war die ganze Zeit am Netzteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac ha estado conectado a la corriente todo el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac est resté branché pendant toute la période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac è stato sempre collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macはずっと電源に接続されていました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac esteve conectado o tempo todo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac全程接着电源。"
          }
        }
      }
    },
    "The Mac woke for a scheduled timer or maintenance task.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac ist für einen geplanten Timer oder eine Wartungsaufgabe aufgewacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac despertó por un temporizador programado o una tarea de mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac s’est réveillé pour une minuterie programmée ou une tâche de maintenance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac si è risvegliato per un timer pianificato o un’attività di manutenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されたタイマーまたはメンテナンス作業のために、Macがスリープ解除されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac acordou por um temporizador agendado ou uma tarefa de manutenção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac因定时器或维护任务而唤醒。"
          }
        }
      }
    },
    "The adapter or cable limits the charging speed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzteil oder Kabel begrenzen die Ladegeschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador o el cable limitan la velocidad de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptateur ou le câble limite la vitesse de charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alimentatore o il cavo limitano la velocità di ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アダプタまたはケーブルが、充電速度を制限しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O adaptador ou o cabo limita a velocidade de carregamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适配器或线缆限制了充电速度。"
          }
        }
      }
    },
    "The battery controller is charging slowly (reason %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriecontroller lädt langsam (Grund %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador de la batería está cargando despacio (motivo %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur de batterie charge lentement (motif %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller della batteria sta caricando lentamente (motivo %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーコントローラがゆっくり充電しています（理由コード: %lld）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador da bateria está carregando devagar (motivo %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池控制器正在缓慢充电（原因：%lld）。"
          }
        }
      }
    },
    "The battery controller paused charging (reason %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriecontroller hat das Laden pausiert (Grund %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador de la batería ha pausado la carga (motivo %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur de batterie a suspendu la charge (motif %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller della batteria ha messo in pausa la ricarica (motivo %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーコントローラが充電を一時停止しました（理由コード: %lld）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador da bateria pausou o carregamento (motivo %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池控制器已暂停充电（原因：%lld）。"
          }
        }
      }
    },
    "The battery drains while plugged in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie entlädt sich trotz Netzteil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería se descarga estando conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie se décharge lorsque le Mac est branché"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria si scarica mentre è collegato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に接続中もバッテリーが減っています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria descarrega com o carregador conectado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接着电源时电池仍在耗电"
          }
        }
      }
    },
    "The battery is full; the adapter powers the Mac directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie ist voll; das Netzteil versorgt den Mac direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está llena; el adaptador alimenta el Mac directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est pleine ; l’adaptateur alimente directement le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria è piena; l’alimentatore alimenta direttamente il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーは満充電です。電源アダプタからMacに直接給電しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está cheia; o adaptador alimenta o Mac diretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池已充满；由适配器直接为Mac供电。"
          }
        }
      }
    },
    "The battery is worn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie ist verschlissen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está desgastada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est usée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria è usurata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが消耗しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está desgastada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池已损耗"
          }
        }
      }
    },
    "The disk is almost full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Festplatte ist fast voll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco casi está lleno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est presque plein"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è quasi pieno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量がほとんどありません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está quase cheio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘几乎已满"
          }
        }
      }
    },
    "The disk is very busy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Festplatte ist stark ausgelastet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está muy ocupado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est très sollicité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è molto impegnato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの負荷が非常に高い状態です"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está muito ocupado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘非常繁忙"
          }
        }
      }
    },
    "The drive can do USB 3 but is connected at USB 2 speed. Usually the cable only does USB 2 (charging cables often do), or a hub or port in between does. Try another cable or plug it straight into the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk kann USB 3, ist aber nur mit USB-2-Tempo verbunden. Meist kann das Kabel nur USB 2 (bei Ladekabeln häufig), oder ein Hub oder Anschluss dazwischen. Probiere ein anderes Kabel oder stecke das Laufwerk direkt am Mac an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad admite USB 3, pero está conectada a la velocidad de USB 2. Normalmente el cable solo admite USB 2 (los cables de carga suelen ser así), o lo hace un concentrador o un puerto intermedio. Prueba con otro cable o conéctala directamente al Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque prend en charge l’USB 3 mais est connecté à la vitesse de l’USB 2. En général, le câble ne gère que l’USB 2 (c’est souvent le cas des câbles de recharge), ou un hub ou un port intermédiaire le fait. Essayez un autre câble ou branchez-le directement sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco supporta USB 3, ma è collegato a velocità USB 2. Di solito il cavo supporta solo USB 2 (spesso i cavi di ricarica), oppure lo fa un hub o una porta intermedia. Prova un altro cavo o collegalo direttamente al Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドライブはUSB 3に対応していますが、USB 2の速度で接続されています。多くの場合、ケーブルがUSB 2のみの対応（充電用ケーブルによくあります）か、間にあるハブやポートがUSB 2のみの対応です。別のケーブルを試すか、Macに直接接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade suporta USB 3, mas está conectada na velocidade do USB 2. Normalmente o cabo só suporta USB 2 (cabos de carregamento costumam ser assim), ou um hub ou porta intermediária suporta. Tente outro cabo ou conecte-o diretamente ao Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该磁盘支持USB 3，但当前以USB 2速度连接。通常是线缆只支持USB 2（充电线往往如此），或者中间的集线器或端口只支持USB 2。请换一根线缆，或直接插到Mac上。"
          }
        }
      }
    },
    "The drive reports less than 1 % of its rated endurance used, too little to project from.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk meldet weniger als 1 % seiner Nennlebensdauer als verbraucht, zu wenig für eine Hochrechnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad indica un desgaste de su resistencia nominal inferior al 1 %; es muy poco para hacer una proyección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque indique moins de 1 % de son endurance nominale utilisée, trop peu pour en faire une projection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco segnala di aver usato meno dell’1 per cento della durata nominale, troppo poco per fare una stima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブの報告によると、定格耐久性の使用量は1%未満で、予測するには少なすぎます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade indica uso inferior a 1 %, pouco demais para fazer projeções sobre a durabilidade nominal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该磁盘报告已用寿命不到其额定耐久度的1%，数据太少，无法据此预测。"
          }
        }
      }
    },
    "The drive says %lld %% of its rated endurance is used after %@ TB written. Reaching 100 %% does not mean it fails that day; it is the point the maker rates it for.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Laufwerk sind nach %2$@ TB Schreibvolumen %1$lld %% seiner Nennlebensdauer verbraucht. 100 %% heißt nicht, dass es an diesem Tag ausfällt; bis dahin gibt der Hersteller es an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The drive says %1$lld %% of its rated endurance is used after %2$@ TB written. Reaching 100 %% does not mean it fails that day; it is the point the maker rates it for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad indica que se ha usado el %lld %% de su resistencia nominal tras escribir %@ TB. Llegar al 100 %% no significa que falle ese día; es el punto para el que la fabricante la certifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque indique que %lld %% de son endurance nominale est utilisée après %@ TB écrits. Atteindre 100 %% ne signifie pas une panne ce jour-là ; c’est le seuil pour lequel le fabricant le prévoit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco indica che è stato usato il %lld %% della durata nominale dopo %@ TB scritti. Arrivare al 100 %% non significa che si guasti quel giorno; è il punto per cui il produttore lo valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ TBの書き込みで、ドライブの定格耐久性の%1$lld%%を使用したと報告されています。100%%に達してもその日に故障するわけではなく、メーカーが定格としている目安です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade indica que %lld %% da durabilidade nominal foi usada após %@ TB gravados. Chegar a 100 %% não significa que ela falhará naquele dia; é o ponto para o qual o fabricante a classifica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该磁盘显示，写入%2$@ TB后，已用掉额定耐久度的%1$lld%%。达到100%%并不意味着当天就会损坏；这只是厂商的额定值。"
          }
        }
      }
    },
    "The embedded controller reported the wake reason: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Embedded Controller hat als Grund fürs Aufwachen gemeldet: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador integrado indicó el motivo del despertar: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur intégré a signalé le motif du réveil : %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller integrato ha segnalato il motivo del risveglio: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵コントローラが報告したスリープ解除の理由: %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador embarcado informou o motivo do despertar: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入式控制器报告的唤醒原因：%@。"
          }
        }
      }
    },
    "The graphics processor is maxed out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Grafikprozessor ist voll ausgelastet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesador gráfico está al límite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processeur graphique est à fond"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il processore grafico è al massimo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフィックスプロセッサの負荷が限界に達しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processador gráfico está no limite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图形处理器已满负荷"
          }
        }
      }
    },
    "The iOS, watchOS and tvOS versions the simulators run; remove old ones in Xcode Settings > Components, and download again when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iOS-, watchOS- und tvOS-Versionen, auf denen die Simulatoren laufen; entferne alte in den Xcode-Einstellungen > Komponenten und lade sie bei Bedarf erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones de iOS, watchOS y tvOS que ejecutan los simuladores; elimina las antiguas en Xcode, en Ajustes > Componentes, y vuelve a descargarlas cuando haga falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Versions d’iOS, de watchOS et de tvOS utilisées par les simulateurs ; supprimez les anciennes dans Réglages de Xcode > Composants, et téléchargez-les de nouveau au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le versioni di iOS, watchOS e tvOS usate dai simulatori; rimuovi quelle vecchie in Xcode, Impostazioni > Componenti, e scaricale di nuovo quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータが実行するiOS、watchOS、tvOSのバージョンです。古いものはXcodeの「設定」>「Components」で削除でき、必要なときに再度ダウンロードできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões de iOS, watchOS e tvOS que os simuladores executam; remova as antigas em Ajustes do Xcode > Componentes e baixe-as novamente quando precisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器运行的iOS、watchOS和tvOS版本；可在Xcode设置 > 组件中移除旧版本，需要时再重新下载。"
          }
        }
      }
    },
    "The installer you downloaded for a macOS version; you can download it again from Apple when you need it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Installer, den du für eine macOS-Version geladen hast; du kannst ihn bei Bedarf erneut von Apple laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador que descargaste de una versión de macOS; puedes volver a descargarlo desde Apple cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme d’installation téléchargé pour une version de macOS ; vous pouvez le télécharger de nouveau auprès d’Apple quand vous en avez besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installer scaricato per una versione di macOS; puoi riscaricarlo da Apple quando ti serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのバージョン用にダウンロードしたインストーラです。必要なときはAppleから再度ダウンロードできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador que você baixou de uma versão do macOS; você pode baixá-lo novamente da Apple quando precisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你下载的某个macOS版本的安装器；需要时可从Apple重新下载。"
          }
        }
      }
    },
    "The lid was opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Deckel wurde geöffnet."
          }
        },
        "es": {
