    "Many small cache folders, each under 50 MB; apps rebuild them as they need them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele kleine Cache-Ordner mit je unter 50 MB; Apps legen sie bei Bedarf neu an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchas carpetas de caché pequeñas, de menos de 50 MB cada una; las apps las regeneran cuando las necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nombreux petits dossiers de cache, chacun de moins de 50 MB ; les apps les recréent au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molte piccole cartelle di cache, ciascuna sotto i 50 MB; le app le ricreano quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50 MB未満の小さなキャッシュフォルダが多数あります。必要に応じてAppが再構築します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas pastas pequenas de cache, cada uma com menos de 50 MB; os apps as recriam quando precisam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许多小型缓存文件夹，每个都小于50 MB；App会在需要时重新生成。"
          }
        }
      }
    },
