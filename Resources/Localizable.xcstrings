        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「調べる」が作成した「%@」のマップから重複を検索します。先に一度スキャンしてから、ここで検索してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
