    "%@ can do USB 3 but is connected at USB 2 speed, up to ten times slower. Usually the cable is a USB 2 or charging cable, or a hub or port in between only does USB 2. Try another cable or plug it straight into the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann USB 3, ist aber nur mit USB-2-Tempo verbunden, bis zu zehnmal langsamer. Meist ist das Kabel ein USB-2- oder Ladekabel, oder ein Hub oder Anschluss dazwischen kann nur USB 2. Probiere ein anderes Kabel oder stecke das Laufwerk direkt am Mac an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ admite USB 3, pero está conectado a la velocidad de USB 2, hasta diez veces más lento. Normalmente el cable es de USB 2 o de carga, o un concentrador o puerto intermedio solo admite USB 2. Prueba con otro cable o conéctalo directamente al Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prend en charge l’USB 3, mais il est connecté à la vitesse de l’USB 2, jusqu’à dix fois plus lente. En général, le câble est un câble USB 2 ou de recharge, ou un hub ou un port intermédiaire ne gère que l’USB 2. Essayez un autre câble ou branchez-le directement sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ supporta USB 3, ma è collegato a velocità USB 2, fino a dieci volte più lenta. Di solito il cavo è USB 2 o di sola ricarica, oppure un hub o una porta intermedia supporta solo USB 2. Prova un altro cavo o collegalo direttamente al Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はUSB 3に対応していますが、USB 2の速度で接続されており、最大で10分の1の速度になります。多くの場合、ケーブルがUSB 2対応または充電用のものか、間にあるハブやポートがUSB 2のみの対応です。別のケーブルを試すか、Macに直接接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ suporta USB 3, mas está conectado na velocidade do USB 2, até dez vezes mais lenta. Normalmente o cabo é USB 2 ou de carregamento, ou um hub ou porta intermediária só suporta USB 2. Tente outro cabo ou conecte-o diretamente ao Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@支持USB 3，但当前以USB 2速度连接，速度最多慢十倍。通常是线缆仅支持USB 2或为充电线，或者中间的集线器或端口仅支持USB 2。请换一根线缆，或直接插到Mac上。"
          }
        }
      }
    },
    "%@ cannot keep up: %@. Use a stronger adapter or close heavy apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommt nicht mit: %@. Nimm ein stärkeres Netzteil oder beende Apps mit viel Last."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ cannot keep up: %2$@. Use a stronger adapter or close heavy apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede seguir el ritmo: %@. Usa un adaptador más potente o cierra las apps que más consumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne suit pas : %@. Utilisez un adaptateur plus puissant ou fermez les apps gourmandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non riesce a stare al passo: %@. Usa un alimentatore più potente o chiudi le app più pesanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@では負荷に追いつきません: %@。出力の大きい電源アダプタを使うか、負荷の高いアプリを終了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não acompanha: %@. Use um adaptador mais potente ou feche apps pesados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@无法满足需求：%@。请使用功率更大的电源适配器，或关闭占用较高的App。"
          }
        }
      }
    },
