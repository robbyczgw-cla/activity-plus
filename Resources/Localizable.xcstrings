    "EXC_ARITHMETIC — the app did an invalid calculation, such as dividing by zero": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — die App hat eine ungültige Berechnung ausgeführt, etwa eine Division durch null"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — la app hizo un cálculo no válido, como dividir entre cero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — l’app a effectué un calcul non valide, par exemple une division par zéro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — l’app ha fatto un calcolo non valido, per esempio una divisione per zero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — Appが、0での除算などの無効な計算を行いました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — o app fez um cálculo inválido, como dividir por zero"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_ARITHMETIC — App执行了无效的计算，例如除以零"
          }
        }
      }
    },
    "EXC_BAD_ACCESS — the app read memory it shouldn't": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_ACCESS — die App hat Speicher gelesen, den sie nicht lesen darf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_ACCESS — la app leyó memoria a la que no debía acceder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_ACCESS — l’app a tenté de lire une mémoire qu’elle ne devait pas lire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
