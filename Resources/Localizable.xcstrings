        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したiPhoneからXcodeがコピーしたデバッグシンボルです。そのiOSのバージョンを次に接続したときに再度コピーされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos de depuração que o Xcode copiou de iPhones conectados; ele os copia novamente na próxima vez que você conectar essa versão do iOS."
