    "Time Machine keeps them while the backup disk is away and removes them after 24 hours or when space runs low.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine behält sie, solange die Sicherungsfestplatte nicht angeschlossen ist, und entfernt sie nach 24 Stunden oder wenn der Platz knapp wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine las conserva mientras el disco de copia de seguridad no está conectado y las elimina pasadas 24 horas o cuando el espacio escasea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine les conserve tant que le disque de sauvegarde est absent et les supprime après 24 heures ou lorsque l’espace vient à manquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine li conserva mentre il disco di backup è scollegato e li rimuove dopo 24 ore o quando lo spazio è poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machineは、バックアップディスクが接続されていない間これらを保持し、24時間後または空き容量が少なくなったときに削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Time Machine os mantém enquanto o disco de backup estiver ausente e os remove após 24 horas ou quando o espaço acabar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份磁盘不在时，时间机器会保留这些快照，并在24小时后或空间不足时将其移除。"
          }
        }
      }
    },
