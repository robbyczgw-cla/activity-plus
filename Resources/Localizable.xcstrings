    "Click a folder to look inside. Colors show the kind of files that take most of each folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Ordner, um hineinzusehen. Die Farben zeigen, welche Dateitypen in jedem Ordner am meisten Platz belegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una carpeta para ver su contenido. Los colores indican el tipo de archivo que más espacio ocupa en cada carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un dossier pour voir ce qu’il contient. Les couleurs indiquent le type de fichiers qui occupe le plus de place dans chaque dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su una cartella per guardarne il contenuto. I colori mostrano il tipo di file che occupa più spazio in ciascuna cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダをクリックすると中身を表示します。色は、各フォルダで最も容量を使っているファイルの種類を示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma pasta para ver o conteúdo. As cores mostram o tipo de arquivo que ocupa mais espaço em cada pasta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按文件夹可查看其中内容。颜色表示占用每个文件夹最多空间的文件种类。"
          }
        }
      }
    },
    "Click a menu bar item for the panel, or use the Dock icon for the window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Objekt in der Menüleiste für das Panel oder nutze das Dock-Symbol für das Fenster."
          }
        },
        "es": {
