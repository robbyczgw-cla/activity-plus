        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのウインドウを表示した状態で、WindowServerはGPUの%@を使用しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
