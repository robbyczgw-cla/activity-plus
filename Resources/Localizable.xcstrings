    "Turn the first item into a warning sign while the Mac is under strain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste Objekt zum Warnzeichen machen, solange der Mac stark belastet ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte el primer elemento en una señal de advertencia cuando el Mac está sobrecargado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformer le premier élément en signal d’alerte lorsque le Mac est sous contrainte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il primo elemento in un segnale di avviso quando il Mac è sotto sforzo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに負荷がかかっている間、最初の項目を警告マークにする"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar o primeiro item em um sinal de alerta enquanto o Mac estiver sob pressão"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac负载过高时，将第一个项目变为警告标志"
          }
        }
      }
    },
    "Turn the meeting up and the music down. Audio is adjusted as it plays; nothing is recorded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Meeting lauter, die Musik leiser. Der Ton wird beim Abspielen angepasst, aufgenommen wird nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la reunión y baja la música. El audio se ajusta mientras suena; no se graba nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte le son de la réunion et baisse celui de la musique. Le son est ajusté pendant la lecture ; rien n’est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la riunione e abbassa la musica. L’audio viene regolato durante la riproduzione; non viene registrato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の音量を上げ、音楽の音量を下げます。オーディオは再生中に調整され、録音されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê mais volume à reunião e menos à música. O áudio é ajustado enquanto toca; nada é gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调高会议声音，调低音乐声音。音频在播放时实时调整；不会录制任何内容。"
          }
        }
      }
    },
