    "Apps whose energy use rose sharply compared with the previous week, often after an update or a stuck background task.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, deren Energieverbrauch gegenüber der Vorwoche stark gestiegen ist, oft nach einem Update oder bei einer hängenden Hintergrundaufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps cuyo consumo de energía ha subido mucho respecto a la semana anterior, a menudo tras una actualización o una tarea en segundo plano atascada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps dont la consommation d’énergie a fortement augmenté par rapport à la semaine précédente, souvent après une mise à jour ou une tâche d’arrière-plan bloquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App il cui consumo di energia è aumentato molto rispetto alla settimana precedente, spesso dopo un aggiornamento o un’attività in background bloccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前週と比べてエネルギー使用量が急に増えたAppです。アップデート後や、バックグラウンドのタスクが止まったときによく見られます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps cujo consumo de energia subiu bastante em relação à semana anterior, geralmente após uma atualização ou uma tarefa em segundo plano travada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能耗与上周相比大幅上升的App，通常发生在更新之后或后台任务卡住时。"
          }
        }
      }
    },
