    "Pods and spec files CocoaPods downloaded earlier; `pod install` downloads them again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pods und Spec-Dateien, die CocoaPods früher geladen hat; `pod install` lädt sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pods y archivos de especificaciones que CocoaPods descargó antes; `pod install` los vuelve a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pods et fichiers de spécifications téléchargés plus tôt par CocoaPods ; `pod install` les télécharge de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod e file spec scaricati in precedenza da CocoaPods; `pod install` li scarica di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前にCocoaPodsがダウンロードしたPodとspecファイルです。`pod install`で再度ダウンロードされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pods e arquivos de especificação que o CocoaPods baixou antes; `pod install` os baixa novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoaPods之前下载的Pods和规范文件；“pod install”会重新下载它们。"
          }
        }
      }
    },
    "Point at the chart to see which processes were behind a spike.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige auf das Diagramm, um zu sehen, welche Prozesse hinter einer Spitze steckten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala el gráfico para ver qué procesos causaron un pico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez le graphique pour voir quels processus sont à l’origine d’un pic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta il grafico per vedere quali processi hanno causato un picco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフにポインタを合わせると、急上昇の原因となったプロセスを確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte para o gráfico para ver quais processos causaram um pico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针移到图表上，可查看是哪些进程造成了峰值。"
          }
