    "Each one runs in the background and starts at login. Turn off the ones you do not need.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes läuft im Hintergrund und startet beim Anmelden. Schalte die aus, die du nicht brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada una se ejecuta en segundo plano y se inicia al iniciar sesión. Desactiva las que no necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun s’exécute en arrière-plan et démarre à l’ouverture de session. Désactivez ceux dont vous n’avez pas besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno viene eseguito in background e si avvia al login. Disattiva quelli che non ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれバックグラウンドで動作し、ログイン時に開始されます。不要なものはオフにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um roda em segundo plano e inicia no início de sessão. Desative os que você não precisa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一项都在后台运行，并在登录时启动。请关闭不需要的项目。"
          }
        }
      }
    },
    "Each simulated iPhone or iPad keeps its own apps and data; Xcode can create new devices, but test data on the old ones is gone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes simulierte iPhone oder iPad hat eigene Apps und Daten; Xcode kann neue Geräte anlegen, doch Testdaten auf den alten gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada iPhone o iPad simulado guarda sus propias apps y datos; Xcode puede crear dispositivos nuevos, pero los datos de prueba de los antiguos se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque iPhone ou iPad simulé conserve ses propres apps et données ; Xcode peut créer de nouveaux appareils, mais les données de test des anciens sont perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni iPhone o iPad simulato conserva le proprie app e i propri dati; Xcode può crearne di nuovi, ma i dati di test di quelli vecchi sono andati persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレートされた各iPhoneまたはiPadは、それぞれのAppとデータを保持しています。Xcodeで新しいデバイスを作成できますが、既存のデバイスのテストデータは失われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada iPhone ou iPad simulado mantém seus próprios apps e dados; o Xcode pode criar novos dispositivos, mas os dados de teste dos antigos se perderam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个模拟的iPhone或iPad都保留自己的App和数据；Xcode可以创建新设备，但旧设备上的测试数据会丢失。"
          }
        }
      }
    },
