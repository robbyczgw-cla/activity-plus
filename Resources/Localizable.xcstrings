    " Unsaved changes will be lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Nicht gesicherte Änderungen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Se perderán los cambios sin guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les modifications non enregistrées seront perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Le modifiche non salvate andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 保存されていない変更は失われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Alterações não salvas serão perdidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 未存储的更改将会丢失。"
          }
