    "Nothing. Your Mac can sleep when idle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts. Dein Mac kann bei Inaktivität in den Ruhezustand wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada. Tu Mac puede entrar en reposo cuando esté inactivo."
