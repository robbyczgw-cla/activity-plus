    "Above about 80 % the battery takes charge more slowly by design.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab etwa 80 % lädt die Batterie bauartbedingt langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de unos 80 %, la batería se carga más despacio por diseño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà d’environ 80 %, la batterie se charge plus lentement par conception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopra circa l’80 % la batteria si carica più lentamente, per progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "80%前後を超えると、仕様上、バッテリーの充電速度が遅くなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima de cerca de 80 %, a bateria carrega mais devagar por projeto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量超过约80%后，电池按设计会放慢充电速度。"
          }
        }
      }
    },
