    "To find the app behind it, Activity+ hides your apps one at a time for a few seconds and measures how much WindowServer's GPU time drops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die App dahinter zu finden, blendet Activity+ deine Apps nacheinander für ein paar Sekunden aus und misst, wie stark die GPU-Zeit von WindowServer sinkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar la app responsable, Activity+ oculta tus apps de una en una durante unos segundos y mide cuánto baja el tiempo de GPU de WindowServer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour trouver l’app responsable, Activity+ masque vos apps une à une pendant quelques secondes et mesure la baisse du temps GPU de WindowServer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trovare l’app responsabile, Activity+ nasconde le tue app una alla volta per alcuni secondi e misura quanto cala il tempo GPU di WindowServer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原因のアプリを特定するため、Activity+はアプリを1つずつ数秒間非表示にし、WindowServerのGPU時間がどれだけ減るかを測定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar o app por trás disso, o Activity+ oculta seus apps um de cada vez por alguns segundos e mede quanto o tempo de GPU do WindowServer cai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为找出背后的App，Activity+会逐个隐藏你的App，每次几秒，并测量WindowServer的GPU时间下降多少。"
          }
        }
      }
    },
