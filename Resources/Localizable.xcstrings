            "value": "geringer Aufwand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "coste bajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "coût faible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "costo basso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低コスト"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "custo baixo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开销小"
          }
        }
      }
    },
    "macOS does not reveal how much each snapshot takes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Platz jeder Snapshot belegt, verrät macOS nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no indica cuánto ocupa cada instantánea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ne révèle pas la taille de chaque instantané."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non mostra quanto occupa ogni snapshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スナップショットがどれだけの容量を使用しているかは、macOSでは確認できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não revela quanto cada snapshot ocupa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS不会显示每个快照占用多少空间。"
          }
        }
      }
    },
    "macOS installer you downloaded; the App Store or Software Update gets it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-Installer, den du geladen hast; App Store oder Softwareupdate holen ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalador de macOS que descargaste; la App Store o Actualización de Software lo vuelve a obtener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme d’installation de macOS téléchargé ; l’App Store ou Mises à jour de logiciels le récupère de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer di macOS scaricato; App Store o Aggiornamento software lo scaricano di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたmacOSのインストーラです。App Storeまたはソフトウェアアップデートで再度入手できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalador do macOS que você baixou; a App Store ou a Atualização de Software o obtém novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你下载的macOS安装器；App Store或“软件更新”可以再次获取。"
          }
        }
      }
    },
    "macOS is compressing memory. It still copes, but quitting unused apps gives it room.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS komprimiert Speicher. Das geht noch gut, aber das Beenden nicht benötigter Apps verschafft Luft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS está comprimiendo memoria. Sigue funcionando, pero salir de las apps que no usas le da espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS compresse la mémoire. Il tient encore le coup, mais quitter les apps inutilisées lui laisse de la marge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sta comprimendo la memoria. Riesce ancora a gestirla, ma uscire dalle app inutilizzate gli dà spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがメモリを圧縮しています。まだ対応できていますが、使っていないアプリを終了すると余裕が生まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está comprimindo a memória. Ele ainda dá conta, mas encerrar apps não usados abre espaço para ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS正在压缩内存。目前还能应付，但退出不用的App可以腾出空间。"
          }
        }
      }
    },
    "macOS is holding the CPU back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bremst die CPU"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS frena la CPU"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS limite le CPU"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sta frenando la CPU"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがCPUの動作を抑えています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está limitando a CPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS正在限制CPU"
          }
        }
      }
    },
    "macOS is not slowing anything down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bremst nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no está ralentizando nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ne ralentit rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non sta rallentando nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSによる低速化は行われていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não está desacelerando nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS没有降低任何速度。"
          }
        }
      }
    },
    "macOS is reducing performance to cool down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS verringert die Leistung, um abzukühlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reduce el rendimiento para enfriarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS réduit les performances pour refroidir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS riduce le prestazioni per raffreddarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは冷却のため、性能を下げています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está reduzindo o desempenho para esfriar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS正在降低性能以散热。"
          }
        }
      }
    },
    "macOS is slowing the processor down to cool it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bremst den Prozessor, um ihn zu kühlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ralentiza el procesador para enfriarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ralentit le processeur pour le refroidir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS rallenta il processore per raffreddarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは冷却のため、プロセッサの動作を遅くしています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está desacelerando o processador para resfriá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS正在降低处理器速度以给其降温。"
          }
        }
      }
    },
    "macOS learned when you usually unplug and finishes charging shortly before. This keeps the battery healthier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat gelernt, wann du das Netzteil normalerweise abziehst, und beendet das Laden kurz davor. Das schont die Batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha aprendido cuándo sueles desconectar el Mac y termina de cargar poco antes. Así la batería se mantiene más sana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a appris quand vous débranchez habituellement le Mac et termine la charge peu avant. Cela préserve mieux la batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha imparato quando di solito stacchi il caricatore e completa la carica poco prima. Così la batteria si mantiene in condizioni migliori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがいつも電源を外す時間帯を学習し、その直前に充電を完了します。これにより、バッテリーの劣化を抑えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS aprendeu quando você costuma desconectar o carregador e termina a carga pouco antes. Isso mantém a bateria mais saudável."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS已了解你通常何时拔掉电源，并在此之前不久完成充电，这样可让电池更健康。"
          }
        }
      }
    },
    "macOS lowers the processor speed to cool down. Give the vents room, remove it from soft surfaces, and quit heavy apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS senkt die Prozessorgeschwindigkeit, um abzukühlen. Gib den Lüftungsschlitzen Platz, nimm den Mac von weichen Unterlagen und beende Apps mit viel Last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS baja la velocidad del procesador para enfriarse. Deja espacio a las rejillas de ventilación, retíralo de superficies blandas y cierra las apps pesadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS réduit la vitesse du processeur pour refroidir. Dégagez les grilles d’aération, posez le Mac sur une surface dure et quittez les apps gourmandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS abbassa la velocità del processore per raffreddarsi. Lascia spazio alle prese d’aria, non appoggiarlo su superfici morbide ed esci dalle app pesanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは冷却のため、プロセッサの速度を下げます。通気口の周囲に空間を確保し、柔らかい面から離して、負荷の高いアプリを終了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS reduz a velocidade do processador para esfriar. Deixe as saídas de ar livres, tire o Mac de superfícies macias e encerre os apps pesados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS会降低处理器速度来散热。请为通风口留出空间，不要放在柔软的表面上，并退出高负载的App。"
          }
        }
      }
    },
    "macOS needs free space for swap, updates and caches. Below about 10 % everything gets slower and updates can fail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS braucht freien Platz für Swap, Updates und Caches. Unter etwa 10 % wird alles langsamer, und Updates können fehlschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS necesita espacio libre para el swap, las actualizaciones y las cachés. Por debajo de unos 10 %, todo va más lento y las actualizaciones pueden fallar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a besoin d’espace libre pour le swap, les mises à jour et les caches. En dessous d’environ 10 %, tout ralentit et les mises à jour peuvent échouer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bisogno di spazio libero per swap, aggiornamenti e cache. Sotto circa il 10 % tutto rallenta e gli aggiornamenti possono fallire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは、スワップ、アップデート、キャッシュのために空き容量を必要とします。約10%を下回ると、すべての動作が遅くなり、アップデートに失敗することがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS precisa de espaço livre para swap, atualizações e caches. Abaixo de cerca de 10 %, tudo fica mais lento e as atualizações podem falhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS需要可用空间来存放交换文件、更新和缓存。低于约10%时，一切都会变慢，更新也可能失败。"
          }
        }
      }
    },
    "macOS shows one grey bar called System Data. This names its parts and says which ones are safe to clear. Activity+ only measures here and changes nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zeigt einen grauen Balken namens „Systemdaten“. Hier siehst du seine Bestandteile und welche davon weg können. Activity+ misst hier nur und ändert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS muestra una única barra gris llamada Datos del sistema. Aquí se nombran sus partes y se indica cuáles se pueden borrar sin riesgo. Activity+ solo mide aquí y no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS affiche une seule barre grise appelée Données système. Cette page en détaille les éléments et indique lesquels peuvent être vidés sans risque. Activity+ se contente de mesurer ici et ne modifie rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mostra un’unica barra grigia chiamata Dati di sistema. Qui ne vengono elencate le parti e indicato quali si possono eliminare senza rischi. Activity+ qui misura soltanto e non cambia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSには「システムデータ」というグレーのバーが1つ表示されます。ここではその内訳と、消去しても安全なものを示します。Activity+は計測するだけで、何も変更しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS mostra uma barra cinza chamada Dados do Sistema. Aqui estão as partes dela e quais podem ser limpas com segurança. O Activity+ apenas mede aqui e não altera nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS显示一个名为“系统数据”的灰色条。这里列出它的各个部分，并说明哪些可以安全清除。Activity+在此处只做测量，不会更改任何内容。"
          }
        }
      }
    },
