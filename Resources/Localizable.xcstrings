    "Moved %@ in %lld items to the Trash. Empty the Trash to free the space.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ in %lld Objekt in den Papierkorb gelegt. Leere den Papierkorb, um den Platz freizugeben."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ in %lld Objekten in den Papierkorb gelegt. Leere den Papierkorb, um den Platz freizugeben."
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Moved %1$@ in %2$lld items to the Trash. Empty the Trash to free the space."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se ha movido %@ en %lld elemento a la Papelera. Vacía la Papelera para liberar el espacio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se han movido %@ en %lld elementos a la Papelera. Vacía la Papelera para liberar el espacio."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ dans %lld élément déplacé dans la Corbeille. Videz la Corbeille pour libérer l’espace."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ dans %lld éléments déplacés dans la Corbeille. Videz la Corbeille pour libérer l’espace."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Spostato nel Cestino: %@ in %lld elemento. Svuota il Cestino per liberare lo spazio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Spostato nel Cestino: %@ in %lld elementi. Svuota il Cestino per liberare lo spazio."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld個の項目（%1$@）をゴミ箱に入れました。ゴミ箱を空にすると容量が空きます。"
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ em %lld item movido para a Lixeira. Esvazie a Lixeira para liberar o espaço."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ em %lld itens movidos para a Lixeira. Esvazie a Lixeira para liberar o espaço."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将%@（共%lld个项目）移到废纸篓。清倒废纸篓即可释放空间。"
          }
        }
      }
    },
