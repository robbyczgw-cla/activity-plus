    "No rules yet. Add one to let Activity+ take care of the usual suspects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln. Füge eine hinzu, damit Activity+ sich um die üblichen Verdächtigen kümmert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay reglas. Añade una para que Activity+ se encargue de los sospechosos habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle pour l’instant. Ajoutez-en une pour qu’Activity+ s’occupe des cas habituels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna regola ancora. Aggiungine una per far gestire ad Activity+ i soliti sospetti."
          }
