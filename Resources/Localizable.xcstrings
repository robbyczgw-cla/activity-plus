            "value": "現在のアプリ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps agora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前App"
          }
        }
      }
    },
    "Apps power": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leistung der Apps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Energía de las apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énergie des apps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentazione app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの電力"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Energia dos apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App功耗"
          }
        }
      }
    },
    "Apps that open at login are managed in System Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die beim Anmelden öffnen, verwaltest du in den Systemeinstellungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que se abren al iniciar sesión se gestionan en Ajustes del Sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui s’ouvrent à la connexion se gèrent dans les Réglages Système"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che si aprono al login si gestiscono in Impostazioni di Sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開くアプリは「システム設定」で管理します"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que abrem no início de sessão são gerenciados em Ajustes do Sistema"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时打开的App在“系统设置”中管理"
          }
        }
      }
    },
    "Apps that use clearly more than usual for them, compared with their own history, for example a helper stuck at full CPU.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die deutlich mehr verbrauchen als sonst, verglichen mit ihrem eigenen Verlauf, zum Beispiel ein Hilfsprozess, der mit voller CPU-Last hängt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que usan bastante más de lo habitual para ellas, comparado con su propio historial; por ejemplo, un auxiliar atascado con la CPU al máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps qui utilisent nettement plus que d’habitude, par rapport à leur propre historique, par exemple un utilitaire bloqué à pleine charge CPU."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App che usano nettamente più del solito rispetto alla loro cronologia, per esempio un helper bloccato a pieno carico sulla CPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自身の履歴と比べて、通常より明らかに多く使用しているAppです。たとえば、CPUを使い切ったまま止まっているヘルパなどです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que usam bem mais do que o normal para eles, comparado com o próprio histórico, por exemplo um auxiliar travado com a CPU no máximo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与自身历史记录相比，用量明显高于平时的App，例如卡在CPU满载的辅助程序。"
          }
        }
      }
    },
    "Apps that used the most": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps mit dem höchsten Verbrauch"
