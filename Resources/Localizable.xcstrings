    "Restore points from Time Machine and macOS updates; macOS removes them on its own and does not report their size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungspunkte von Time Machine und macOS-Updates; macOS entfernt sie selbst und meldet ihre Größe nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de restauración de Time Machine y de las actualizaciones de macOS; macOS los elimina por su cuenta y no indica su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de restauration créés par Time Machine et les mises à jour de macOS ; macOS les supprime automatiquement et n’indique pas leur taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punti di ripristino di Time Machine e degli aggiornamenti di macOS; macOS li rimuove da solo e non indica la loro dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Time MachineとmacOSアップデートの復元ポイントです。macOSが自動的に削除し、サイズは報告されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos de restauração do Time Machine e de atualizações do macOS; o macOS os remove sozinho e não informa o tamanho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine和macOS更新的还原点；macOS会自行移除它们，且不会报告其大小。"
          }
        }
      }
    },
