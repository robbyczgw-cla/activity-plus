    "Stopped because it took too long to start or answer (watchdog)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet, weil Start oder Antwort zu lange gedauert haben (Watchdog)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenida porque tardó demasiado en iniciarse o en responder (watchdog)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté parce qu’il a mis trop de temps à démarrer ou à répondre (watchdog)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrestata perché ci ha messo troppo ad avviarsi o a rispondere (watchdog)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動または応答に時間がかかりすぎたため停止されました（watchdog）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido porque demorou demais para iniciar ou responder (watchdog)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因启动或响应时间过长而被停止（watchdog）"
          }
        }
      }
    },
