    "Keep at least one item so Activity+ stays reachable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte mindestens ein Objekt, damit Activity+ erreichbar bleibt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén al menos un elemento para que se pueda acceder a Activity+"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez au moins un élément pour qu’Activity+ reste accessible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni almeno un elemento, così Activity+ resta raggiungibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity+を開けるよう、項目を少なくとも1つ残してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pelo menos um item para que o Activity+ continue acessível"
          }
        },
