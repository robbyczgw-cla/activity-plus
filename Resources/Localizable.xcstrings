    "Duplicates are looked up in the map that Explore builds of “%@”. Scan once, then search here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplikate werden in der Karte gesucht, die „Entdecken“ von „%@“ anlegt. Scanne einmal, dann suche hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los duplicados se buscan en el mapa que Explorar crea de «%@». Analiza una vez y luego busca aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les doublons sont recherchés dans la carte qu’Explorer établit pour « %@ ». Analysez une fois, puis recherchez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
