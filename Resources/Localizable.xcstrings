          }
        }
      }
    },
    "%lld items start a program that does not exist any more. They do nothing, and are marked below. Items in your own folder can be moved to the Trash here; system-wide ones need an administrator.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Objekt startet ein Programm, das es nicht mehr gibt. Es tut nichts und ist unten markiert. Objekte in deinem eigenen Ordner kannst du hier in den Papierkorb legen; systemweite brauchen Administratorrechte."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Objekte starten ein Programm, das es nicht mehr gibt. Sie tun nichts und sind unten markiert. Objekte in deinem eigenen Ordner kannst du hier in den Papierkorb legen; systemweite brauchen Administratorrechte."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item starts a program that does not exist any more. It does nothing, and is marked below. Items in your own folder can be moved to the Trash here; system-wide ones need an administrator."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items start a program that does not exist any more. They do nothing, and are marked below. Items in your own folder can be moved to the Trash here; system-wide ones need an administrator."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elemento inicia un programa que ya no existe. No hace nada y se marca abajo. Los elementos de tu carpeta se pueden mover a la Papelera desde aquí; los de todo el sistema necesitan un administrador."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elementos inician un programa que ya no existe. No hacen nada y se marcan abajo. Los elementos de tu carpeta se pueden mover a la Papelera desde aquí; los de todo el sistema necesitan un administrador."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld élément lance un programme qui n’existe plus. Il ne fait rien et est marqué ci-dessous. Les éléments de votre dossier peuvent être déplacés dans la Corbeille ici ; ceux du système entier nécessitent un administrateur."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld éléments lancent un programme qui n’existe plus. Ils ne font rien et sont marqués ci-dessous. Les éléments de votre dossier peuvent être déplacés dans la Corbeille ici ; ceux du système entier nécessitent un administrateur."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elemento avvia un programma che non esiste più. Non fa nulla ed è contrassegnato qui sotto. Gli elementi nella tua cartella possono essere spostati nel Cestino da qui; quelli di sistema richiedono un amministratore."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld elementi avviano un programma che non esiste più. Non fanno nulla e sono contrassegnati qui sotto. Gli elementi nella tua cartella possono essere spostati nel Cestino da qui; quelli di sistema richiedono un amministratore."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個の項目が、存在しないプログラムを起動しようとしています。何も実行されず、下に印が付いています。ご自身のフォルダ内の項目はここでゴミ箱に入れられますが、システム全体の項目には管理者権限が必要です。"
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item inicia um programa que não existe mais. Ele não faz nada e está marcado abaixo. Itens da sua pasta podem ser movidos para a Lixeira aqui; os de todo o sistema exigem um administrador."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld itens iniciam programas que não existem mais. Eles não fazem nada e estão marcados abaixo. Itens da sua pasta podem ser movidos para a Lixeira aqui; os de todo o sistema exigem um administrador."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有%lld个项目会启动已不存在的程序。它们不起任何作用，并已在下方标出。你自己文件夹中的项目可以在此移到废纸篓；系统范围的项目需要管理员权限。"
          }
        }
      }
    },
