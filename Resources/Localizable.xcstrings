    "The %lld W adapter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das %lld-W-Netzteil"
          }
        }
      }
    },
    "The CPU averaged %@ over the last minutes. Everything else has to wait for it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CPU lag in den letzten Minuten im Schnitt bei %@. Alles andere muss auf sie warten."
          }
        }
      }
    },
    "The Mac needs more than the adapter delivers, so the battery makes up the rest. A stronger adapter or fewer heavy apps help.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac braucht mehr, als das Netzteil liefert; die Batterie gleicht den Rest aus. Ein stärkeres Netzteil oder weniger Apps mit hoher Last helfen."
          }
        }
      }
    },
    "The Mac was plugged in the whole time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac war die ganze Zeit am Netzteil."
          }
        }
      }
    },
    "The Mac woke for a scheduled timer or maintenance task.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac ist für einen geplanten Timer oder eine Wartungsaufgabe aufgewacht."
          }
        }
      }
    },
    "The adapter or cable limits the charging speed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzteil oder Kabel begrenzen die Ladegeschwindigkeit."
          }
        }
      }
    },
    "The battery controller is charging slowly (reason %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriecontroller lädt langsam (Grund %lld)."
          }
        }
      }
    },
    "The battery controller paused charging (reason %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriecontroller hat das Laden pausiert (Grund %lld)."
          }
        }
      }
