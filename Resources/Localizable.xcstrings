    "Reports macOS wrote when apps crashed or hung; removing them loses nothing but the history.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichte, die macOS bei Abstürzen oder Hängern von Apps geschrieben hat; beim Entfernen geht nur der Verlauf verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informes que macOS escribió cuando las apps se cerraron o se bloquearon; al eliminarlos solo se pierde el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapports écrits par macOS lorsque des apps ont planté ou se sont bloquées ; les supprimer ne fait perdre que l’historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Report che macOS scrive quando le app si bloccano o non rispondono; rimuoverli non fa perdere nulla tranne la cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがクラッシュまたは応答停止したときにmacOSが書き込んだレポートです。削除すると履歴が失われるだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatórios que o macOS gerou quando apps travaram ou pararam de responder; removê-los não causa perda além do histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS在App崩溃或无响应时写入的报告；移除它们只会丢失历史记录，不会有其他损失。"
          }
        }
      }
    },
