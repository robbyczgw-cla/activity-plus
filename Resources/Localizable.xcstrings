            "state": "translated",
            "value": "Bluetooth-Aktivität hat den Mac geweckt, oft ein verbundenes Eingabegerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad de Bluetooth, a menudo de un dispositivo de entrada emparejado, despertó el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une activité Bluetooth, souvent un périphérique de saisie associé, a réveillé le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività Bluetooth, spesso di un dispositivo di input associato, ha risvegliato il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothのアクティビティ（多くの場合、ペアリング済みの入力デバイス）によって、Macがスリープ解除されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividade de Bluetooth, geralmente de um dispositivo de entrada pareado, acordou o Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙活动（通常是已配对的输入设备）唤醒了Mac。"
          }
        }
      }
    },
    "Browsers Playwright uses for tests; it downloads them again when you run a test (about 1 GB).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser, die Playwright für Tests nutzt; beim nächsten Test werden sie erneut geladen (etwa 1 GB)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegadores que Playwright usa para las pruebas; se vuelven a descargar al ejecutar una prueba (unos 1 GB)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigateurs utilisés par Playwright pour les tests ; ils sont téléchargés de nouveau à chaque lancement d’un test (environ 1 GB)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser che Playwright usa per i test; vengono scaricati di nuovo quando esegui un test (circa 1 GB)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwrightがテストに使用するブラウザです。テストを実行すると再度ダウンロードされます（約1 GB）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegadores que o Playwright usa nos testes; ele os baixa novamente ao executar um teste (cerca de 1 GB)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright用于测试的浏览器；运行测试时会重新下载（约1 GB）。"
          }
        }
      }
    },
