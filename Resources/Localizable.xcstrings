    "All incoming connections are blocked, except for basic system services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle eingehenden Verbindungen sind gesperrt, außer für grundlegende Systemdienste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bloquean todas las conexiones entrantes, excepto los servicios básicos del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les connexions entrantes sont bloquées, sauf les services système de base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le connessioni in entrata sono bloccate, tranne i servizi di sistema essenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的なシステムサービスを除き、すべての着信接続がブロックされています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as conexões de entrada são bloqueadas, exceto os serviços básicos do sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除基本系统服务外，所有传入连接均被阻止。"
          }
        }
      }
    },
    "All of them are doing something.": {
