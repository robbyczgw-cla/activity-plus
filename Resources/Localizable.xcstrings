        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App停止响应"
          }
        }
      }
    },
    "The battery controller is charging slowly (reason %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriecontroller lädt langsam (Grund %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador de la batería está cargando despacio (motivo %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur de batterie charge lentement (motif %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller della batteria sta caricando lentamente (motivo %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーコントローラがゆっくり充電しています（理由コード: %lld）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador da bateria está carregando devagar (motivo %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池控制器正在缓慢充电（原因：%lld）。"
          }
        }
      }
    },
    "The battery controller paused charging (reason %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriecontroller hat das Laden pausiert (Grund %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador de la batería ha pausado la carga (motivo %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur de batterie a suspendu la charge (motif %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller della batteria ha messo in pausa la ricarica (motivo %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーコントローラが充電を一時停止しました（理由コード: %lld）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador da bateria pausou o carregamento (motivo %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池控制器已暂停充电（原因：%lld）。"
          }
        }
      }
    },
    "The battery drains while plugged in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie entlädt sich trotz Netzteil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería se descarga estando conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie se décharge lorsque le Mac est branché"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria si scarica mentre è collegato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に接続中もバッテリーが減っています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria descarrega com o carregador conectado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接着电源时电池仍在耗电"
          }
        }
      }
    },
    "The battery is full; the adapter powers the Mac directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie ist voll; das Netzteil versorgt den Mac direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está llena; el adaptador alimenta el Mac directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est pleine ; l’adaptateur alimente directement le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria è piena; l’alimentatore alimenta direttamente il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーは満充電です。電源アダプタからMacに直接給電しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está cheia; o adaptador alimenta o Mac diretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池已充满；由适配器直接为Mac供电。"
          }
        }
      }
    },
    "The battery is worn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie ist verschlissen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está desgastada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est usée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria è usurata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが消耗しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está desgastada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池已损耗"
          }
        }
      }
    },
    "The biggest folders and files in the folder you are looking at, largest first. Right-click an item to show it in Finder or move it to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größten Ordner und Dateien im angezeigten Ordner, die größten zuerst. Klicke mit der rechten Maustaste auf ein Objekt, um es im Finder zu zeigen oder in den Papierkorb zu legen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas y archivos más grandes de la carpeta que estás viendo, del mayor al menor. Haz clic derecho en un elemento para mostrarlo en el Finder o moverlo a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus gros dossiers et fichiers du dossier affiché, du plus grand au plus petit. Cliquez avec le bouton droit sur un élément pour l’afficher dans le Finder ou le déplacer dans la Corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle e i file più grandi nella cartella che stai guardando, dal più grande. Fai clic destro su un elemento per mostrarlo nel Finder o spostarlo nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のフォルダ内にある大きなフォルダとファイルを、大きい順に表示します。項目を右クリックすると、Finderで表示したり、ゴミ箱に入れたりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As maiores pastas e arquivos da pasta que você está vendo, do maior para o menor. Clique com o botão direito em um item para mostrá-lo no Finder ou movê-lo para a Lixeira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前所查看文件夹中最大的文件夹和文件，按大小从大到小排列。右键点按项目可在访达中显示或移到废纸篓。"
          }
        }
      }
    },
    "The chart range applies to the large charts on the detail pages; the small curves on the overview always show about ten minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diagrammzeitraum gilt für die großen Diagramme auf den Detailseiten; die kleinen Kurven in der Übersicht zeigen immer etwa zehn Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rango del gráfico se aplica a los gráficos grandes de las páginas de detalle; las curvas pequeñas del resumen muestran siempre unos diez minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plage du graphique s’applique aux grands graphiques des pages de détail ; les petites courbes de l’aperçu affichent toujours environ dix minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervallo dei grafici vale per i grafici grandi delle pagine di dettaglio; le piccole curve della panoramica mostrano sempre circa dieci minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフの期間は、詳細ページの大きなグラフに適用されます。概要の小さな曲線には、常に約10分間が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo do gráfico se aplica aos gráficos grandes das páginas de detalhes; as curvas pequenas da visão geral sempre mostram cerca de dez minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图表范围适用于详细信息页面中的大图表；概览中的小曲线始终显示约十分钟。"
          }
        }
      }
    },
    "The disk is almost full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Festplatte ist fast voll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco casi está lleno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est presque plein"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è quasi pieno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量がほとんどありません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está quase cheio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘几乎已满"
          }
        }
      }
    },
    "The disk is being encrypted. It is protected once this finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Festplatte wird verschlüsselt. Sie ist geschützt, sobald das fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está cifrando el disco. Quedará protegido cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est en cours de chiffrement. Il sera protégé une fois l’opération terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è in fase di cifratura. Sarà protetto al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクを暗号化しています。完了すると保護されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está sendo criptografado. Ele fica protegido quando isso terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘正在加密。完成后即受到保护。"
          }
        }
      }
    },
    "The disk is very busy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Festplatte ist stark ausgelastet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está muy ocupado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est très sollicité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è molto impegnato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの負荷が非常に高い状態です"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está muito ocupado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘非常繁忙"
          }
        }
      }
    },
    "The drive can do USB 3 but is connected at USB 2 speed. Usually the cable only does USB 2 (charging cables often do), or a hub or port in between does. Try another cable or plug it straight into the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk kann USB 3, ist aber nur mit USB-2-Tempo verbunden. Meist kann das Kabel nur USB 2 (bei Ladekabeln häufig), oder ein Hub oder Anschluss dazwischen. Probiere ein anderes Kabel oder stecke das Laufwerk direkt am Mac an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad admite USB 3, pero está conectada a la velocidad de USB 2. Normalmente el cable solo admite USB 2 (los cables de carga suelen ser así), o lo hace un concentrador o un puerto intermedio. Prueba con otro cable o conéctala directamente al Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque prend en charge l’USB 3 mais est connecté à la vitesse de l’USB 2. En général, le câble ne gère que l’USB 2 (c’est souvent le cas des câbles de recharge), ou un hub ou un port intermédiaire le fait. Essayez un autre câble ou branchez-le directement sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco supporta USB 3, ma è collegato a velocità USB 2. Di solito il cavo supporta solo USB 2 (spesso i cavi di ricarica), oppure lo fa un hub o una porta intermedia. Prova un altro cavo o collegalo direttamente al Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドライブはUSB 3に対応していますが、USB 2の速度で接続されています。多くの場合、ケーブルがUSB 2のみの対応（充電用ケーブルによくあります）か、間にあるハブやポートがUSB 2のみの対応です。別のケーブルを試すか、Macに直接接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade suporta USB 3, mas está conectada na velocidade do USB 2. Normalmente o cabo só suporta USB 2 (cabos de carregamento costumam ser assim), ou um hub ou porta intermediária suporta. Tente outro cabo ou conecte-o diretamente ao Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该磁盘支持USB 3，但当前以USB 2速度连接。通常是线缆只支持USB 2（充电线往往如此），或者中间的集线器或端口只支持USB 2。请换一根线缆，或直接插到Mac上。"
          }
        }
      }
    },
    "The drive itself cannot be moved to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk selbst kann nicht in den Papierkorb gelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propio disco no se puede mover a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque lui-même ne peut pas être déplacé dans la Corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco stesso non può essere spostato nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブ自体はゴミ箱に入れられません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio disco não pode ser movido para a Lixeira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘本身无法移到废纸篓。"
          }
        }
      }
    },
    "The drive reports less than 1 % of its rated endurance used, too little to project from.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk meldet weniger als 1 % seiner Nennlebensdauer als verbraucht, zu wenig für eine Hochrechnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad indica un desgaste de su resistencia nominal inferior al 1 %; es muy poco para hacer una proyección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque indique moins de 1 % de son endurance nominale utilisée, trop peu pour en faire une projection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco segnala di aver usato meno dell’1 per cento della durata nominale, troppo poco per fare una stima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブの報告によると、定格耐久性の使用量は1%未満で、予測するには少なすぎます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade indica uso inferior a 1 %, pouco demais para fazer projeções sobre a durabilidade nominal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该磁盘报告已用寿命不到其额定耐久度的1%，数据太少，无法据此预测。"
          }
        }
      }
    },
    "The drive says %lld %% of its rated endurance is used after %@ TB written. Reaching 100 %% does not mean it fails that day; it is the point the maker rates it for.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Laufwerk sind nach %2$@ TB Schreibvolumen %1$lld %% seiner Nennlebensdauer verbraucht. 100 %% heißt nicht, dass es an diesem Tag ausfällt; bis dahin gibt der Hersteller es an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The drive says %1$lld %% of its rated endurance is used after %2$@ TB written. Reaching 100 %% does not mean it fails that day; it is the point the maker rates it for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad indica que se ha usado el %lld %% de su resistencia nominal tras escribir %@ TB. Llegar al 100 %% no significa que falle ese día; es el punto para el que la fabricante la certifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque indique que %lld %% de son endurance nominale est utilisée après %@ TB écrits. Atteindre 100 %% ne signifie pas une panne ce jour-là ; c’est le seuil pour lequel le fabricant le prévoit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco indica che è stato usato il %lld %% della durata nominale dopo %@ TB scritti. Arrivare al 100 %% non significa che si guasti quel giorno; è il punto per cui il produttore lo valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ TBの書き込みで、ドライブの定格耐久性の%1$lld%%を使用したと報告されています。100%%に達してもその日に故障するわけではなく、メーカーが定格としている目安です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade indica que %lld %% da durabilidade nominal foi usada após %@ TB gravados. Chegar a 100 %% não significa que ela falhará naquele dia; é o ponto para o qual o fabricante a classifica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该磁盘显示，写入%2$@ TB后，已用掉额定耐久度的%1$lld%%。达到100%%并不意味着当天就会损坏；这只是厂商的额定值。"
          }
        }
      }
    },
    "The embedded controller reported the wake reason: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Embedded Controller hat als Grund fürs Aufwachen gemeldet: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador integrado indicó el motivo del despertar: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur intégré a signalé le motif du réveil : %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller integrato ha segnalato il motivo del risveglio: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵コントローラが報告したスリープ解除の理由: %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador embarcado informou o motivo do despertar: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入式控制器报告的唤醒原因：%@。"
          }
        }
      }
    },
    "The fans stayed quiet today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüfter blieben heute leise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores han estado tranquilos hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ventilateurs sont restés silencieux aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ventole sono rimaste silenziose oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はファンが静かなままでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ventoinhas ficaram silenciosas hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天风扇一直很安静。"
          }
        }
      }
    },
    "The file %@ moves to the Trash and the item is stopped in your session. %@ does not exist, so nothing is lost. You can put the file back from the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei %@ wird in den Papierkorb gelegt und das Objekt in deiner Sitzung gestoppt. %@ existiert nicht, es geht also nichts verloren. Du kannst die Datei aus dem Papierkorb zurücklegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The file %1$@ moves to the Trash and the item is stopped in your session. %2$@ does not exist, so nothing is lost. You can put the file back from the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo %@ se mueve a la Papelera y el elemento se detiene en tu sesión. %@ no existe, así que no se pierde nada. Puedes devolver el archivo desde la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier %@ est déplacé dans la Corbeille et l’élément est arrêté dans votre session. %@ n’existe pas, rien n’est donc perdu. Vous pouvez remettre le fichier depuis la Corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file %@ viene spostato nel Cestino e l’elemento viene arrestato nella tua sessione. %@ non esiste, quindi non si perde nulla. Puoi rimettere il file a posto dal Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル%@をゴミ箱に入れ、この項目を現在のセッションで停止します。%@は存在しないため、失われるものはありません。ファイルはゴミ箱から元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo %@ vai para a Lixeira e o item é interrompido na sua sessão. %@ não existe, então nada se perde. Você pode restaurar o arquivo da Lixeira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件%@将移到废纸篓，且该项目会在你的会话中停止。%@并不存在，因此不会有任何损失。你可以从废纸篓中放回该文件。"
          }
        }
      }
    },
    "The graphics processor is maxed out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Grafikprozessor ist voll ausgelastet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesador gráfico está al límite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processeur graphique est à fond"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il processore grafico è al massimo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフィックスプロセッサの負荷が限界に達しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processador gráfico está no limite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图形处理器已满负荷"
          }
        }
      }
    },
    "The iOS, watchOS and tvOS versions the simulators run; remove old ones in Xcode Settings > Components, and download again when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iOS-, watchOS- und tvOS-Versionen, auf denen die Simulatoren laufen; entferne alte in den Xcode-Einstellungen > Komponenten und lade sie bei Bedarf erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones de iOS, watchOS y tvOS que ejecutan los simuladores; elimina las antiguas en Xcode, en Ajustes > Componentes, y vuelve a descargarlas cuando haga falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Versions d’iOS, de watchOS et de tvOS utilisées par les simulateurs ; supprimez les anciennes dans Réglages de Xcode > Composants, et téléchargez-les de nouveau au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le versioni di iOS, watchOS e tvOS usate dai simulatori; rimuovi quelle vecchie in Xcode, Impostazioni > Componenti, e scaricale di nuovo quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータが実行するiOS、watchOS、tvOSのバージョンです。古いものはXcodeの「設定」>「Components」で削除でき、必要なときに再度ダウンロードできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões de iOS, watchOS e tvOS que os simuladores executam; remova as antigas em Ajustes do Xcode > Componentes e baixe-as novamente quando precisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器运行的iOS、watchOS和tvOS版本；可在Xcode设置 > 组件中移除旧版本，需要时再重新下载。"
          }
        }
      }
    },
    "The index was not rebuilt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Index wurde nicht neu aufgebaut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice no se ha reconstruido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index n’a pas été reconstruit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice non è stato ricostruito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックスは再構築されませんでした"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O índice não foi reconstruído"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引未重建"
          }
        }
      }
    },
    "The installer you downloaded for a macOS version; you can download it again from Apple when you need it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Installer, den du für eine macOS-Version geladen hast; du kannst ihn bei Bedarf erneut von Apple laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador que descargaste de una versión de macOS; puedes volver a descargarlo desde Apple cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme d’installation téléchargé pour une version de macOS ; vous pouvez le télécharger de nouveau auprès d’Apple quand vous en avez besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installer scaricato per una versione di macOS; puoi riscaricarlo da Apple quando ti serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのバージョン用にダウンロードしたインストーラです。必要なときはAppleから再度ダウンロードできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador que você baixou de uma versão do macOS; você pode baixá-lo novamente da Apple quando precisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你下载的某个macOS版本的安装器；需要时可从Apple重新下载。"
          }
        }
      }
    },
    "The last Time Machine backup to %@ was %lld days ago.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die letzte Time Machine-Sicherung auf %@ war vor %lld Tag."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die letzte Time Machine-Sicherung auf %@ war vor %lld Tagen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The last Time Machine backup to %@ was %lld day ago."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The last Time Machine backup to %@ was %lld days ago."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La última copia de Time Machine en %@ fue hace %lld día."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La última copia de Time Machine en %@ fue hace %lld días."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La dernière sauvegarde Time Machine sur %@ remonte à %lld jour."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La dernière sauvegarde Time Machine sur %@ remonte à %lld jours."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’ultimo backup di Time Machine su %@ risale a %lld giorno fa."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’ultimo backup di Time Machine su %@ risale a %lld giorni fa."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@への最後のTime Machineバックアップは%lld日前です。"
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O último backup do Time Machine para %@ foi há %lld dia."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O último backup do Time Machine para %@ foi há %lld dias."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次备份到“%@”的时间机器备份是在%lld天前。"
          }
        }
      }
    },
    "The lid was opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Deckel wurde geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrió la tapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capot a été ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coperchio è stato aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイが開かれました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tampa foi aberta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕已被打开。"
          }
        }
      }
    },
    "The load comes from the displays themselves or from several apps together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Last kommt von den Displays selbst oder von mehreren Apps zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga viene de las propias pantallas o de varias apps a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge vient des écrans eux-mêmes ou de plusieurs apps à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il carico deriva dagli schermi stessi o da più app insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷の原因は、ディスプレイ自体か、複数のアプリの合計です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carga vem das próprias telas ou de vários apps juntos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载来自显示器本身，或来自多个App的叠加。"
          }
        }
      }
    },
    "The menu bar is off (General → Show Activity+ in → Dock only). These items appear once you turn it back on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüleiste ist aus (Allgemein → Activity+ zeigen in → Nur Dock). Diese Objekte erscheinen, sobald du sie wieder einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de menús está desactivada (General → Mostrar Activity+ en → Solo el Dock). Estos elementos aparecerán cuando la vuelvas a activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre des menus est désactivée (Général → Afficher Activity+ dans → Dock uniquement). Ces éléments apparaîtront dès que vous la réactiverez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra dei menu è disattivata (Generale → Mostra Activity+ in → Solo Dock). Questi elementi compaiono quando la riattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーはオフです（一般 →「Activity+の表示場所」→「Dockのみ」）。オンに戻すと、これらの項目が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de menus está desativada (Geral → Mostrar o Activity+ em → Somente o Dock). Esses itens aparecem quando você a reativar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏已关闭（通用 → 显示Activity+于 → 仅Dock）。重新开启后，这些项目就会出现。"
          }
        }
      }
    },
    "The newest copy. Tick the others to remove them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Kopie. Hake die anderen an, um sie zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia más reciente. Marca las demás para quitarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie la plus récente. Cochez les autres pour les déplacer dans la Corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia più recente. Seleziona le altre per rimuoverle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のコピーです。ほかのコピーにチェックを入れると削除対象になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia mais recente. Marque as outras para removê-las."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新的副本。勾选其他副本即可将其移除。"
          }
        }
      }
    },
    "The page that was open last": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite, die zuletzt geöffnet war"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página que estaba abierta por última vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page ouverte en dernier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina aperta per ultima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に開いていたページ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A página que estava aberta por último"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次打开的页面"
          }
        }
      }
    },
    "The part of the chip for machine learning, used for things like dictation, photo analysis and on-device AI. Not every Mac reports its power.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Teil des Chips für maschinelles Lernen, genutzt etwa für Diktat, Fotoanalyse und KI auf dem Gerät. Nicht jeder Mac meldet seine Leistung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte del chip para aprendizaje automático, usada para cosas como el dictado, el análisis de fotos y la IA en el dispositivo. No todos los Mac informan de su potencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie de la puce dédiée au machine learning, utilisée pour la dictée, l’analyse de photos et l’IA sur l’appareil. Tous les Mac n’indiquent pas leur consommation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte del chip dedicata all’apprendimento automatico, usata per cose come la dettatura, l’analisi delle foto e l’IA sul dispositivo. Non tutti i Mac segnalano la sua potenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械学習用のチップ部分で、音声入力、写真の解析、デバイス上のAIなどに使われます。すべてのMacが電力を報告するわけではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte do chip para aprendizado de máquina, usada em coisas como ditado, análise de fotos e IA no dispositivo. Nem todo Mac informa sua potência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "芯片中用于机器学习的部分，用于听写、照片分析和设备端AI等功能。并非每台Mac都会报告其功耗。"
          }
        }
      }
    },
    "The power button was pressed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ein-/Aus-Taste wurde gedrückt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pulsó el botón de encendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton d’alimentation a été pressé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato premuto il pulsante di accensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源ボタンが押されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão de energia foi pressionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下了电源按钮。"
          }
        }
      }
    },
    "The processor is busy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozessor ist ausgelastet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesador está ocupado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processeur est occupé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il processore è occupato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセッサの負荷が高い状態です"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processador está ocupado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理器很忙"
          }
        }
      }
    },
    "The program it should start, %@, is not there any more, so it does nothing. Its app was probably removed without cleaning up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Programm, das gestartet werden soll, %@, gibt es nicht mehr, deshalb passiert nichts. Die zugehörige App wurde wohl entfernt, ohne aufzuräumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa que debería iniciar, %@, ya no está, así que no hace nada. Probablemente su app se eliminó sin limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme qu’il doit lancer, %@, n’existe plus : il ne fait donc rien. Son app a probablement été supprimée sans nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma che dovrebbe avviare, %@, non c’è più, quindi non fa nulla. Probabilmente la sua app è stata rimossa senza pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動するはずのプログラム「%@」はもう存在しないため、何も実行されません。おそらく、整理せずにAppが削除されたためです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa que ele deveria iniciar, %@, não existe mais, então ele não faz nada. O app provavelmente foi removido sem limpeza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它应当启动的程序%@已不存在，因此不起任何作用。其App可能在移除时没有清理干净。"
          }
        }
      }
    },
    "The report Activity+ recorded while the app was frozen, stored in ~/Library/Logs/Activity+/Freezes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht, den Activity+ aufgenommen hat, während die App hing, gespeichert in ~/Library/Logs/Activity+/Freezes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe que Activity+ registró mientras la app estaba bloqueada, guardado en ~/Library/Logs/Activity+/Freezes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport enregistré par Activity+ pendant le blocage de l’app, stocké dans ~/Library/Logs/Activity+/Freezes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il report registrato da Activity+ mentre l’app era bloccata, salvato in ~/Library/Logs/Activity+/Freezes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがフリーズしている間にActivity+が記録したレポート。保存先: ~/Library/Logs/Activity+/Freezes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório que o Activity+ registrou enquanto o app estava travado, armazenado em ~/Library/Logs/Activity+/Freezes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App卡死期间Activity+记录的报告，存储在~/Library/Logs/Activity+/Freezes"
          }
        }
      }
    },
    "The report does not say why": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht nennt keinen Grund"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe no indica el motivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport n’indique pas la raison"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il report non spiega il motivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートには理由が記載されていません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório não informa o motivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告中没有说明原因"
          }
        }
      }
    },
    "The report fills up while Activity+ runs. Check back after a few days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht füllt sich, während Activity+ läuft. Schau nach ein paar Tagen wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe se llena mientras Activity+ está en marcha. Vuelve a mirarlo dentro de unos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport se remplit pendant l’exécution d’Activity+. Revenez dans quelques jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il report si riempie mentre Activity+ è in esecuzione. Torna a controllare tra qualche giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートは、Activity+の実行中に蓄積されます。数日後にもう一度ご確認ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório é preenchido enquanto o Activity+ roda. Volte em alguns dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity+运行期间报告会逐渐丰富。请过几天再来查看。"
          }
        }
      }
    },
