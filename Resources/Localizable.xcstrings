    "Keeps the menu bar clean: the item appears only while the value is high.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Menüleiste aufgeräumt: Das Objekt erscheint nur, solange der Wert hoch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene limpia la barra de menús: el elemento solo aparece mientras el valor es alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la barre des menus épurée : l’élément n’apparaît que lorsque la valeur est élevée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene pulita la barra dei menu: l’elemento compare solo quando il valore è alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーをすっきり保ちます。値が高い間だけ項目が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de menus limpa: o item aparece só enquanto o valor estiver alto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让菜单栏保持整洁：仅当数值较高时才显示该项目。"
          }
        }
      }
    },
    "Killed for using too much memory (jetsam)": {
