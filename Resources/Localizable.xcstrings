    "do not show their GPU use under their own name: it is counted as WindowServer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zeigen ihre GPU-Nutzung nicht unter ihrem eigenen Namen: Sie wird WindowServer zugerechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no muestran su uso de GPU con su propio nombre: se cuenta como WindowServer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "n’affichent pas leur utilisation GPU sous leur propre nom : elle est comptée sous WindowServer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "non mostrano il loro uso della GPU con il proprio nome: viene conteggiato come WindowServer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
