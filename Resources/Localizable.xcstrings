    },
    "Libraries and build output Gradle downloaded; it downloads them again on the next build, which needs internet and takes longer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheken und Build-Ausgaben, die Gradle geladen hat; beim nächsten Build lädt Gradle sie erneut, was Internet braucht und länger dauert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotecas y resultados de compilación que Gradle descargó; los vuelve a descargar en la próxima compilación, que necesita internet y tarda más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèques et résultats de compilation téléchargés par Gradle ; il les télécharge de nouveau à la prochaine compilation, ce qui nécessite Internet et prend plus de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Librerie e output di compilazione scaricati da Gradle; vengono scaricati di nuovo alla prossima compilazione, che richiede connessione a internet e più tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradleがダウンロードしたライブラリとビルド出力です。次回のビルドで再度ダウンロードされるため、インターネット接続が必要で時間もかかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotecas e saídas de build que o Gradle baixou; ele as baixa novamente no próximo build, o que exige internet e demora mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle下载的库和构建输出；下次构建时会重新下载，这需要联网并且耗时更长。"
          }
        }
      }
    },
