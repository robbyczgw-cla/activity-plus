      }
    },
    "One shared copy of the packages your projects use; pnpm downloads them again, and projects keep working until you reinstall.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gemeinsame Kopie der Pakete, die deine Projekte nutzen; pnpm lädt sie erneut, und Projekte laufen weiter, bis du neu installierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia compartida de los paquetes que usan tus proyectos; pnpm los vuelve a descargar, y los proyectos siguen funcionando hasta que reinstales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie partagée unique des paquets utilisés par vos projets ; pnpm les télécharge de nouveau, et les projets continuent de fonctionner jusqu’à une réinstallation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’unica copia condivisa dei pacchetti usati dai tuoi progetti; pnpm li scarica di nuovo e i progetti continuano a funzionare finché non reinstalli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトが使用するパッケージの共有コピーです。pnpmが再度ダウンロードし、再インストールするまではプロジェクトも動作し続けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia compartilhada dos pacotes que seus projetos usam; o pnpm os baixa novamente, e os projetos continuam funcionando até você reinstalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的项目所用软件包的一份共享副本；pnpm会重新下载它们，在重新安装之前项目仍可正常运行。"
          }
        }
      }
    },
    "Only %.0f Hz: often a cable or adapter that cannot carry more at this resolution.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %.0f Hz: oft ein Kabel oder Adapter, der bei dieser Auflösung nicht mehr übertragen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %.0f Hz: a menudo es un cable o adaptador que no admite más a esta resolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %.0f Hz : souvent un câble ou un adaptateur incapable d’en supporter davantage à cette résolution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %.0f Hz: spesso un cavo o un alimentatore che non reggono di più a questa risoluzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f Hzのみ: この解像度でそれ以上を伝送できないケーブルやアダプタが原因であることが多いです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %.0f Hz: muitas vezes é um cabo ou adaptador que não suporta mais nessa resolução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅%.0f Hz：通常是线缆或转接器无法在此分辨率下传输更多数据。"
          }
        }
      }
    },
    "Only %@ free on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %@ frei auf %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Only %1$@ free on %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %@ libres en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %@ libres sur %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %@ liberi su %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の空きは%1$@だけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %@ livres em %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@上仅剩%1$@可用。"
          }
        }
      }
    },
    "Only for a broken search: needs an administrator password and takes hours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur bei defekter Suche: braucht ein Administratorpasswort und dauert Stunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para una búsqueda rota: necesita la contraseña de administrador y tarda horas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement en cas de recherche défectueuse : nécessite un mot de passe administrateur et prend des heures"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se la ricerca è guasta: richiede la password di un amministratore e ci vogliono ore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索が壊れている場合のみ: 管理者パスワードが必要で、数時間かかります"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para uma busca com defeito: exige senha de administrador e leva horas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于搜索已损坏的情况：需要管理员密码，并且要花几个小时"
          }
        }
      }
    },
    "Only items in your own LaunchAgents folder can be moved to the Trash here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Objekte in deinem eigenen Ordner „LaunchAgents“ kannst du hier in den Papierkorb legen."
          }
        },
        "es": {
          "stringUnit": {
