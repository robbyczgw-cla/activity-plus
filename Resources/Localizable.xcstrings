          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer l’enregistrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia registrazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を開始"
          }
        },
        "pt-BR": {
