    "Writes and reads a test file large enough to get past the cache, so the result is the drive's real speed. The file is removed afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt und liest eine Testdatei, die groß genug ist, um am Cache vorbeizukommen, sodass das Ergebnis die echte Geschwindigkeit des Laufwerks zeigt. Die Datei wird danach entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe y lee un archivo de prueba lo bastante grande para superar la caché, así que el resultado es la velocidad real del disco. El archivo se elimina después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit et relit un fichier de test assez volumineux pour dépasser le cache, afin que le résultat soit la vitesse réelle du disque. Le fichier est supprimé ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive e legge un file di prova abbastanza grande da superare la cache, così il risultato è la velocità reale del disco. Il file viene rimosso al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを超える十分な大きさのテストファイルを書き込んで読み込むため、結果はドライブの実際の速度になります。ファイルは終了後に削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava e lê um arquivo de teste grande o suficiente para passar do cache, então o resultado é a velocidade real do disco. O arquivo é removido depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入并读取一个足够大、能绕过缓存的测试文件，因此结果就是磁盘的真实速度。之后该文件会被移除。"
          }
        }
      }
    },
    "Writes and reads one 1 GB file in your caches folder, then removes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt und liest eine 1-GB-Datei in deinem Cache-Ordner und löscht sie danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe y lee un archivo de 1 GB en tu carpeta de cachés y luego lo elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit puis lit un fichier de 1 GB dans votre dossier de caches, puis le supprime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive e legge un file da 1 GB nella cartella delle cache, poi lo rimuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュフォルダに1 GBのファイルを1つ書き込んで読み込み、その後削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava e lê um arquivo de 1 GB na sua pasta de caches e depois o remove."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
