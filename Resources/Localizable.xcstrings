    "%@ move to the Trash. One copy of each file stays where it is. You can put them back from the Trash until you empty it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommen in den Papierkorb. Von jeder Datei bleibt eine Kopie an ihrem Platz. Bis du den Papierkorb leerst, kannst du sie zurücklegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se moverán a la Papelera. Cada archivo conserva una copia en su sitio. Puedes devolverlos desde la Papelera hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront déplacés dans la Corbeille. Une copie de chaque fichier reste à sa place. Vous pouvez les remettre depuis la Corbeille tant que vous ne l’avez pas vidée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ da spostare nel Cestino. Di ogni file resta una copia dov’è. Puoi rimetterle a posto dal Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をゴミ箱に入れます。各ファイルのコピーが1つずつ元の場所に残ります。ゴミ箱を空にするまでは、ゴミ箱から元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vão para a Lixeira. Uma cópia de cada arquivo fica onde está. Você pode restaurá-los da Lixeira enquanto ela não for esvaziada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@将移到废纸篓。每个文件都会保留一份在原处。清倒废纸篓之前，你可以从废纸篓中放回。"
          }
        }
      }
    },
    "%@ move to the Trash. You can put them back from the Trash until you empty it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommen in den Papierkorb. Bis du ihn leerst, kannst du alles zurücklegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se mueven a la Papelera. Puedes recuperarlos desde la Papelera hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront déplacés dans la Corbeille. Vous pouvez les remettre depuis la Corbeille tant que vous ne l’avez pas vidée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vengono spostati nel Cestino. Puoi recuperarli dal Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をゴミ箱に入れます。ゴミ箱を空にするまでは、ゴミ箱から元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão movidos para a Lixeira. Você pode restaurá-los da Lixeira até esvaziá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@将移到废纸篓。清倒废纸篓之前，你可以从废纸篓中放回。"
          }
        }
      }
    },
    "%@ moves to the Trash. Quit the apps first so they do not recreate their caches right away. Empty the Trash to actually free the space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird in den Papierkorb gelegt. Beende die Apps vorher, damit sie ihre Caches nicht sofort neu anlegen. Den Platz bekommst du erst zurück, wenn du den Papierkorb leerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se mueve a la Papelera. Cierra antes las apps para que no vuelvan a crear sus cachés de inmediato. Vacía la Papelera para liberar el espacio de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déplacé dans la Corbeille. Quittez d’abord les apps pour qu’elles ne recréent pas aussitôt leurs caches. Videz la Corbeille pour libérer réellement l’espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene spostato nel Cestino. Esci prima dalle app, così non ricreano subito la cache. Svuota il Cestino per liberare davvero lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をゴミ箱に入れます。キャッシュがすぐに再作成されないよう、先にアプリを終了してください。空き容量を実際に増やすには、ゴミ箱を空にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será movido para a Lixeira. Encerre os apps antes, para que não recriem os caches imediatamente. Esvazie a Lixeira para liberar o espaço de fato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@将移到废纸篓。请先退出相关App，以免它们马上重新创建缓存。清倒废纸篓后才会真正释放空间。"
          }
        }
      }
    },
    "%@ moves to the Trash. You can put everything back from the Trash until you empty it.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
