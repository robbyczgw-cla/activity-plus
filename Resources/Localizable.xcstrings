    "Measured %@. Sizes are space actually used on disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen um %@. Die Größen entsprechen dem tatsächlich belegten Platz auf dem Volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido el %@. Los tamaños son el espacio realmente ocupado en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré %@. Les tailles correspondent à l’espace réellement occupé sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurato %@. Le dimensioni indicano lo spazio effettivamente occupato su disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に計測しました。サイズはディスク上で実際に使用されている容量です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido %@. Os tamanhos são o espaço realmente usado no disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已测量%@。大小为磁盘上实际占用的空间。"
          }
        }
      }
    },
    "Measured by the kernel's per-process energy counters, not estimated. Processes owned by macOS are not included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen mit den Energiezählern des Kernels pro Prozess, nicht geschätzt. Prozesse von macOS sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido con los contadores de energía por proceso del núcleo, no estimado. No se incluyen los procesos de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré par les compteurs d’énergie par processus du noyau, et non estimé. Les processus appartenant à macOS ne sont pas inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurato dai contatori di energia per processo del kernel, non stimato. I processi di macOS non sono inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値ではなく、カーネルのプロセスごとのエネルギーカウンタによる実測値です。macOSが所有するプロセスは含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido pelos contadores de energia por processo do kernel, não estimado. Processos do macOS não estão incluídos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由内核的进程能耗计数器测得，并非估算值。属于macOS的进程不包含在内。"
          }
        }
      }
    },
    "Measurements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte"
          }
        },
        "es": {
