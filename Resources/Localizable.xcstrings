        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement vos processus ; les processus système nécessitent l’utilitaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i tuoi processi; i processi di sistema richiedono l’assistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身のプロセスのみ。システムプロセスにはヘルパが必要です。"
