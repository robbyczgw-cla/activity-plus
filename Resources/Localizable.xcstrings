    "The battery drains while plugged in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie entlädt sich trotz Netzteil"
          }
        }
      }
    },
    "The battery is full; the adapter powers the Mac directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie ist voll; das Netzteil versorgt den Mac direkt."
