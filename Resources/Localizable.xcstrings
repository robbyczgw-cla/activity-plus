    "Charging is slowed to keep the battery cool.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden wird gedrosselt, damit die Batterie kühl bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga se ralentiza para mantener la batería fresca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge est ralentie pour garder la batterie au frais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricarica è rallentata per mantenere la batteria fresca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーの温度を保つため、充電速度を抑えています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento é reduzido para manter a bateria fria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为让电池保持低温，充电速度已放慢。"
          }
        }
      }
    },
    "Charging paused by the battery controller (reason %lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden vom Batterie-Controller angehalten (Grund %lld)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga la ha pausado el controlador de batería (motivo %lld)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge suspendue par le contrôleur de batterie (motif %lld)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica in pausa per il controller della batteria (motivo %lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーコントローラが充電を一時停止しました（理由コード: %lld）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregamento pausado pelo controlador da bateria (motivo %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池控制器已暂停充电（原因：%lld）"
          }
        }
      }
    },
    "Charging pauses while the battery is too hot or too cold, and resumes on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden pausiert, solange die Batterie zu heiß oder zu kalt ist, und setzt von selbst wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga se pausa mientras la batería está demasiado caliente o demasiado fría, y se reanuda sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge se suspend lorsque la batterie est trop chaude ou trop froide, puis reprend d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricarica si mette in pausa quando la batteria è troppo calda o troppo fredda e riprende da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが高温または低温の間は充電が一時停止し、自動的に再開されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento pausa enquanto a bateria estiver quente ou fria demais, e retoma sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池过热或过冷时会暂停充电，并在恢复正常后自动继续。"
          }
        }
      }
    },
