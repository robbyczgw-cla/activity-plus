    "Measured %@. Sizes are space actually used on disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen um %@. Die Größen entsprechen dem tatsächlich belegten Platz auf dem Volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido el %@. Los tamaños son el espacio realmente ocupado en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré %@. Les tailles correspondent à l’espace réellement occupé sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurato %@. Le dimensioni indicano lo spazio effettivamente occupato su disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に計測しました。サイズはディスク上で実際に使用されている容量です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido %@. Os tamanhos são o espaço realmente usado no disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已测量%@。大小为磁盘上实际占用的空间。"
          }
        }
      }
    },
    "Measured by the kernel's per-process energy counters, not estimated. Processes owned by macOS are not included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen mit den Energiezählern des Kernels pro Prozess, nicht geschätzt. Prozesse von macOS sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido con los contadores de energía por proceso del núcleo, no estimado. No se incluyen los procesos de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré par les compteurs d’énergie par processus du noyau, et non estimé. Les processus appartenant à macOS ne sont pas inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurato dai contatori di energia per processo del kernel, non stimato. I processi di macOS non sono inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値ではなく、カーネルのプロセスごとのエネルギーカウンタによる実測値です。macOSが所有するプロセスは含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido pelos contadores de energia por processo do kernel, não estimado. Processos do macOS não estão incluídos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由内核的进程能耗计数器测得，并非估算值。属于macOS的进程不包含在内。"
          }
        }
      }
    },
    "Measurements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesures"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定値"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medições"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量数据"
          }
        }
      }
    },
    "Measures every %@ until you stop it. You can also start and stop from the menu bar (right-click).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst alle %@, bis du stoppst. Starten und stoppen kannst du auch über die Menüleiste (Rechtsklick)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide cada %@ hasta que lo detengas. También puedes iniciar y detener desde la barra de menús (clic secundario)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure toutes les %@ jusqu’à son arrêt. Vous pouvez aussi démarrer et arrêter depuis la barre des menus (clic droit)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura ogni %@ finché non lo interrompi. Puoi anche avviare e interrompere dalla barra dei menu (clic destro)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止するまで%@ごとに測定します。メニューバー（右クリック）から開始・停止することもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede a cada %@ até você parar. Você também pode iniciar e parar pela barra de menus (clique com o botão direito)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔%@测量一次，直到你停止。你也可以通过菜单栏启动和停止（右键点按）。"
          }
        }
      }
    },
    "Measures how fast your SSD writes and reads large files. Takes a few seconds and writes 1 GB, which is removed afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst, wie schnell deine SSD große Dateien schreibt und liest. Dauert ein paar Sekunden und schreibt 1 GB, das danach wieder gelöscht wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide la velocidad de escritura y lectura de archivos grandes en tu SSD. Tarda unos segundos y escribe 1 GB, que se borra después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure la vitesse d’écriture et de lecture de gros fichiers sur votre SSD. Prend quelques secondes et écrit 1 GB, supprimé ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura la velocità con cui il tuo SSD scrive e legge file grandi. Richiede pochi secondi e scrive 1 GB, che viene poi rimosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSDが大きなファイルを書き込み・読み込みする速度を測定します。数秒かかり、1 GBを書き込みますが、測定後に削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede a velocidade com que o SSD grava e lê arquivos grandes. Leva alguns segundos e grava 1 GB, que é removido depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量SSD读写大文件的速度。需要几秒钟，并会写入1 GB数据，之后会自动移除。"
          }
        }
      }
    },
    "Measuring": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messung"
          }
        },
        "es": {
