    "With no window or panel open, Activity+ measures at most every 5 seconds to save energy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne offenes Fenster oder Panel misst Activity+ höchstens alle 5 Sekunden, um Energie zu sparen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ventanas ni paneles abiertos, Activity+ mide como mucho cada 5 segundos para ahorrar energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans fenêtre ni panneau ouvert, Activity+ mesure au plus toutes les 5 secondes pour économiser l’énergie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza finestre o pannello aperti, Activity+ misura al massimo ogni 5 secondi per risparmiare energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウやパネルを開いていないときは、省エネのため、Activity+は5秒に1回までの頻度で測定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem janela nem painel abertos, o Activity+ mede no máximo a cada 5 segundos para economizar energia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开窗口或面板时，为节省电量，Activity+最多每5秒测量一次。"
          }
        }
      }
    },
