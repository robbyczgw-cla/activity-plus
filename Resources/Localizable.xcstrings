            "state": "translated",
            "value": "Fragt WindowServer alle paar Sekunden nach jeder geöffneten App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta a WindowServer sobre cada app abierta cada pocos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge WindowServer sur chaque app ouverte toutes les quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede a WindowServer lo stato di ogni app aperta ogni pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
