    "Health is what a full charge holds today compared with the battery when new.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zustand ist das, was eine volle Ladung heute fasst, verglichen mit der Batterie im Neuzustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado es la capacidad que tiene hoy una carga completa, comparada con la batería nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La santé correspond à la capacité qu’une charge complète permet aujourd’hui, comparée à celle de la batterie neuve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato indica quanta carica completa regge oggi la batteria rispetto a quando era nuova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態とは、新品時のバッテリーと比べた、現在の満充電時の容量です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saúde é a capacidade que uma carga completa mantém hoje, em comparação com a bateria nova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康状况是指当前满电容量与电池全新时相比的比例。"
          }
        }
      }
    },
