    "Emulators you created in Android Studio, with their apps and data; you can create new ones, but the data on these is lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulatoren, die du in Android Studio angelegt hast, samt Apps und Daten; du kannst neue anlegen, aber die Daten auf diesen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emuladores que creaste en Android Studio, con sus apps y datos; puedes crear otros nuevos, pero los datos de estos se perderán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émulateurs créés dans Android Studio, avec leurs apps et leurs données ; vous pouvez en créer de nouveaux, mais les données de ceux-ci sont perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulatori creati in Android Studio, con le relative app e i dati; puoi crearne di nuovi, ma i dati di questi andranno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studioで作成したエミュレータと、そのAppおよびデータです。新しく作成できますが、これらのデータは失われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emuladores criados no Android Studio, com seus apps e dados; você pode criar novos, mas os dados destes se perdem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在Android Studio中创建的模拟器，包含其App和数据；你可以创建新的，但这些模拟器上的数据会丢失。"
          }
        }
      }
    },
