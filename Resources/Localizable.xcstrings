    "One belongs to an update that is downloaded and prepared but not installed yet. It can take several GB until you install the update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines gehört zu einem Update, das geladen und vorbereitet, aber noch nicht installiert ist. Es kann mehrere GB belegen, bis du das Update installierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno pertenece a una actualización descargada y preparada, pero aún no instalada. Puede ocupar varios GB hasta que instales la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’un d’eux appartient à une mise à jour téléchargée et préparée mais pas encore installée. Elle peut occuper plusieurs GB tant que vous ne l’installez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno appartiene a un aggiornamento scaricato e preparato ma non ancora installato. Può occupare diversi GB finché non installi l’aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つは、ダウンロードと準備が完了しているが、まだインストールされていないアップデートのものです。アップデートをインストールするまで、数GBを占めることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deles pertence a uma atualização baixada e preparada, mas ainda não instalada. Pode ocupar vários GB até você instalar a atualização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一个属于已下载并准备好、但尚未安装的更新。在你安装该更新之前，它可能占用数GB空间。"
          }
        }
      }
    },
    "One copy always stays.": {
      "localizations": {
        "de": {
          "stringUnit": {
