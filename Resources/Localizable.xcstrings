    "Xcode archive of an old build; you only need it to submit that build again or to read its crash reports.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode-Archiv eines alten Builds; du brauchst es nur, um diesen Build erneut einzureichen oder seine Absturzberichte zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
