            "state": "translated",
            "value": "Se abrió la tapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capot a été ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coperchio è stato aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイが開かれました。"
          }
        },
        "pt-BR": {
