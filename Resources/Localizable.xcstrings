    "Not every item fit next to the notch, so they are shown as one. Click a value to open its tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Objekte passten neben die Notch, deshalb werden sie als eines angezeigt. Klicke auf einen Wert, um den zugehörigen Tab zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No todos los elementos caben junto al notch, así que se muestran como uno. Haz clic en un valor para abrir su pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les éléments ne tiennent pas à côté de l’encoche : ils sont donc affichés en un seul. Cliquez sur une valeur pour ouvrir son onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tutti gli elementi entrano accanto alla tacca, quindi vengono mostrati come uno. Fai clic su un valore per aprire la sua scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての項目がノッチの横に収まらないため、1つにまとめて表示しています。値をクリックすると、そのタブが開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem todos os itens couberam ao lado do notch, então são exibidos como um só. Clique em um valor para abrir sua aba."
