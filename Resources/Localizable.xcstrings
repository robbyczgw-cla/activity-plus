    },
    "EXC_BAD_INSTRUCTION — the app ran into an instruction that is not valid, often a failed internal check": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — die App ist auf eine ungültige Anweisung gestoßen, oft wegen einer fehlgeschlagenen internen Prüfung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — la app encontró una instrucción no válida, a menudo por una comprobación interna fallida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — l’app a rencontré une instruction non valide, souvent après l’échec d’un contrôle interne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — l’app ha incontrato un’istruzione non valida, spesso per un controllo interno fallito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — Appが無効な命令に遭遇しました。内部チェックの失敗であることが多いです"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — o app encontrou uma instrução inválida, geralmente uma verificação interna que falhou"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EXC_BAD_INSTRUCTION — App遇到了无效的指令，通常是内部检查失败"
          }
        }
      }
    },
    "EXC_BREAKPOINT — the app stopped itself after an internal check failed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
