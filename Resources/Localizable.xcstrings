    "Downloaded or built data the tool fetches or rebuilds on the next run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene oder erzeugte Daten, die das Werkzeug beim nächsten Lauf neu lädt oder aufbaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos descargados o generados que la herramienta recupera o regenera en la próxima ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données téléchargées ou compilées que l’outil récupère ou recrée à sa prochaine exécution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati scaricati o compilati che lo strumento recupera o ricrea alla prossima esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールが次回の実行時に取得または再構築する、ダウンロード済みまたはビルド済みのデータです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados baixados ou gerados que a ferramenta busca ou recria na próxima execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具获取或在下次运行时重新构建的已下载或已构建数据。"
          }
        }
      }
    },
