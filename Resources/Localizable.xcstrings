    "Fan speed in revolutions per minute. Many Apple silicon Macs keep the fans off until they are needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lüftergeschwindigkeit in Umdrehungen pro Minute. Viele Macs mit Apple Silicon lassen die Lüfter aus, bis sie gebraucht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad del ventilador en revoluciones por minuto. Muchos Mac con Apple silicon mantienen los ventiladores apagados hasta que hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse des ventilateurs en tours par minute. Beaucoup de Mac à puce Apple gardent les ventilateurs à l’arrêt tant qu’ils ne sont pas nécessaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità della ventola in giri al minuto. Molti Mac con Apple silicon tengono le ventole spente finché non servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンの速度（毎分回転数）です。Appleシリコンを搭載した多くのMacは、必要になるまでファンを停止しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidade da ventoinha em rotações por minuto. Muitos Macs com Apple silicon mantêm as ventoinhas desligadas até que sejam necessárias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇转速，单位为每分钟转数。许多搭载Apple芯片的Mac在不需要时会让风扇保持关闭。"
          }
        }
      }
    },
