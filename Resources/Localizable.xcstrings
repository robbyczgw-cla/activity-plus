    "Debug symbols Xcode copied from Apple Watches you connected; it copies them again the next time you connect that watchOS version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-Symbole, die Xcode von verbundenen Apple Watches kopiert hat; beim nächsten Verbinden dieser watchOS-Version kopiert Xcode sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos de depuración que Xcode copió de los Apple Watch que conectaste; los vuelve a copiar la próxima vez que conectes esa versión de watchOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboles de débogage copiés par Xcode depuis les Apple Watch connectées ; Xcode les recopie la prochaine fois que vous connectez cette version de watchOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simboli di debug che Xcode ha copiato dagli Apple Watch collegati; vengono copiati di nuovo la prossima volta che colleghi quella versione di watchOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したApple WatchからXcodeがコピーしたデバッグシンボルです。そのwatchOSのバージョンを次に接続したときに再度コピーされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos de depuração que o Xcode copiou de Apple Watches conectados; ele os copia novamente na próxima vez que você conectar essa versão do watchOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode从你连接过的Apple Watch复制的调试符号；下次连接该watchOS版本时会重新复制。"
          }
        }
      }
    },
    "Debug symbols Xcode copied from iPhones you connected; it copies them again the next time you connect that iOS version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-Symbole, die Xcode von verbundenen iPhones kopiert hat; beim nächsten Verbinden dieser iOS-Version kopiert Xcode sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos de depuración que Xcode copió de los iPhone que conectaste; los vuelve a copiar la próxima vez que conectes esa versión de iOS."
