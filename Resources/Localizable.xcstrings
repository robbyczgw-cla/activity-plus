    "%lld are running now. Turning one off stops it and keeps it from starting at login.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld läuft gerade. Ausschalten beendet es und verhindert, dass es beim Anmelden startet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld laufen gerade. Ausschalten beendet eines und verhindert, dass es beim Anmelden startet."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld is running now. Turning it off stops it and keeps it from starting at login."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld are running now. Turning one off stops it and keeps it from starting at login."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld está en ejecución ahora. Apagarlo lo detiene y evita que se inicie al iniciar sesión."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld están en ejecución ahora. Apagar uno lo detiene y evita que se inicie al iniciar sesión."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld en cours d’exécution. L’arrêter empêche son démarrage à l’ouverture de session."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld en cours d’exécution. En arrêter un empêche son démarrage à l’ouverture de session."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld è in esecuzione ora. Disattivarlo lo ferma e impedisce l’avvio al login."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sono in esecuzione ora. Disattivarne uno lo ferma e impedisce che si avvii al login."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個が現在実行中です。オフにすると、停止し、ログイン時に開始されなくなります。"
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld está em execução agora. Desativá-lo interrompe e impede que ele inicie no início de sessão."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld estão em execução agora. Desativar um deles interrompe e impede que ele inicie no início de sessão."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前有%lld个正在运行。关闭其中一个会将其停止，并使其不再于登录时启动。"
          }
        }
      }
    },
    "%lld charge cycles": {
      "localizations": {
