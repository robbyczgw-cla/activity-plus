    "FileVault is being turned off and the disk is being decrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault wird ausgeschaltet und die Festplatte entschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está desactivando FileVault y el disco se está descifrando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault est en cours de désactivation et le disque est en cours de déchiffrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault viene disattivato e il disco viene decifrato."
          }
        },
        "ja": {
          "stringUnit": {
