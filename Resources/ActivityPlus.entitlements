<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Per-app volume reads other apps' audio through Core Audio process taps. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- "Restart…" in the diagnosis asks System Events to restart the Mac. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The Wi-Fi scan needs Location access for network names; the hardened runtime wants this entitlement. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Shares the widget snapshot with the widget extension (Contents/PlugIns/ActivityPlusWidgets.appex). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>P35939S43T.at.hifiteam.activityplus</string>
	</array>
</dict>
</plist>
